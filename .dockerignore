# Archivos que no entran al contexto de construcción de la imagen (Dockerfile).
# Además de acelerar el build, evita que secretos o datos locales terminen en la imagen.

.dockerignore
.git
.github
.githooks
.claude

# Secretos (ERS §10.3): nunca dentro de la imagen.
.env
.env.*
!.env.example

# Artefactos de desarrollo y pruebas
/_build/
/deps/
/cover/
/doc/
/docs/
/test/
/tmp/
/dev/
.elixir_ls
*.ez
erl_crash.dump

# Datos locales (SDE, matrices, snapshots): se generan en el volumen de datos.
/priv/data/

# Estáticos generados: se construyen dentro de la imagen.
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json
