# Copiar a .env y completar. Nunca commitear .env (ERS §10.3).
# Guía paso a paso en README.md.

# ─── Obligatorias ────────────────────────────────────────────────────────────────────

# Tu aplicación de EVE (https://developers.eveonline.com/applications), con el callback
# http://localhost:4000/auth/eve/callback y los 13 scopes de README.md.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Tu email, para el User-Agent de ESI (RNF-3.1): EVE lo pide para poder contactarte.
ESI_CONTACT=

# Clave AES-256 en Base64 que cifra los tokens de EVE (RNF-4.2). Generar con:
#   docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"
# Guardá una copia: sin ella hay que volver a iniciar sesión con cada personaje.
ETH_VAULT_KEY=

# ─── Opcionales ──────────────────────────────────────────────────────────────────────

# Regiones a escanear (IDs separados por comas). Vacío: todo el universo.
# El entorno de desarrollo (docker-compose.yml) usa por defecto los 5 hubs.
# ETH_REGIONS=10000002,10000043

# Feed de kills del radar (RF-3.1): r2z2 (por defecto) u off.
# ETH_KILLFEED=r2z2

# Solo estos personajes pueden iniciar sesión (IDs separados por comas). Vacío: cualquiera.
# ETH_ALLOWED_CHARACTER_IDS=

# Fecha de compatibilidad de ESI (por defecto la de config/config.exs).
# ESI_COMPATIBILITY_DATE=2026-09-01

# Clave que firma las cookies. En la imagen de producción se genera sola la primera vez y
# se guarda en el volumen de datos; definirla solo si querés fijarla.
# SECRET_KEY_BASE=

# ─── Solo desarrollo ─────────────────────────────────────────────────────────────────

# Fuente de datos de mercado: live (ESI) o replay (snapshots grabados, sin red).
# ETH_DATA_SOURCE=live
