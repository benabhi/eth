# Copiar a .env y completar. Nunca commitear .env (ERS §10.3).

# Aplicación EVE SSO (https://developers.eveonline.com) — necesaria desde F4.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
# EVE_CALLBACK_URL la define docker-compose.yml: http://localhost:4000/auth/eve/callback

# Contacto (email) para el User-Agent de ESI (RNF-3.1).
ESI_CONTACT=

# Fecha de compatibilidad de ESI (opcional; por defecto la de config/config.exs).
# ESI_COMPATIBILITY_DATE=2026-09-01

# Clave AES-256 en Base64 para cifrar refresh tokens. Generar con:
#   docker compose run --rm phoenix mix run --no-start -e "IO.puts(:crypto.strong_rand_bytes(32) |> Base.encode64())"
ETH_VAULT_KEY=

# Desarrollo: subconjunto de regiones y fuente de datos (live | replay).
# ETH_REGIONS=10000002,10000043
# ETH_DATA_SOURCE=live
# ETH_KILLFEED=r2z2
