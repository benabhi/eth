<Layouts.app flash={@flash} active={:hunter}>
  <section class="space-y-2">
    <h1 class="text-3xl font-bold">{gettext("Cazador de trades")}</h1>
    <p class="text-base-content/70">
      {gettext(
        "Oportunidades de arbitraje en todo New Eden, ajustadas a tu billetera, tu nave, tu ubicación y el riesgo de la ruta."
      )}
    </p>
  </section>

  <div role="status" class="alert alert-info alert-soft">
    <.icon name="hero-wrench-screwdriver" class="size-5" />
    <span>
      {gettext(
        "En construcción: fase F0 (fundaciones). El escaneo de mercado llega en la fase F1."
      )}
    </span>
  </div>

  <section aria-labelledby="roadmap-title" class="card border border-base-300">
    <div class="card-body">
      <h2 id="roadmap-title" class="card-title">{gettext("Próximas fases")}</h2>
      <ol class="list-decimal space-y-1 pl-5">
        <li>{gettext("F1 · Adquisición de mercado y Centro de control")}</li>
        <li>{gettext("F2 · Datos estáticos (SDE) y ruteo")}</li>
        <li>{gettext("F3 · Motor de evaluación y Cazador (modo invitado)")}</li>
        <li>{gettext("F4 · Login con EVE SSO y contexto del piloto")}</li>
      </ol>
    </div>
  </section>
</Layouts.app>
