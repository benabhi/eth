<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:hunter}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <.board_header
    title={gettext("Tablón de caza")}
    family={:station}
    search={@form[:search].value}
    status_id="station-status"
  >
    <:stats :if={@meta}>
      <.stat
        id="station-open"
        label={gettext("oportunidades")}
        value={Format.integer(@total)}
        class="items-end"
      />
      <.stat
        id="station-reward"
        label={gettext("beneficio por día")}
        value={Format.compact(@reward)}
        value_class="text-accent"
        class="items-end"
      />
    </:stats>
    <:status>
      <%= if @meta do %>
        {gettext("%{total} oportunidades de station trading", total: Format.integer(@total))} · {gettext(
          "evaluado %{ago}",
          ago: Format.ago(@meta.evaluated_at, @now)
        )}
      <% else %>
        {gettext("El motor todavía no evaluó el mercado: espera el primer ciclo de descarga.")}
      <% end %>
    </:status>
  </.board_header>

  <%!-- Mis órdenes (RF-4.17) --%>
  <.panel :if={@pilot} id="my-orders" title={gettext("Mis órdenes")} help={:own_orders}>
    <:help_body>
      {gettext(
        "Tus órdenes abiertas: si otra orden te superó, el precio sugerido te vuelve a poner primero."
      )}
    </:help_body>
    <:actions>
      <div
        :if={@my_orders_summary}
        id="my-orders-summary"
        class="flex items-center gap-4 text-xs eth-muted tabular-nums"
      >
        <span class="flex items-center gap-2">
          <.ring
            value={min(@my_orders_summary.count / max(@my_orders_summary.limit, 1), 1.0)}
            size={28}
            stroke={3}
            class={
              if(@my_orders_summary.count >= @my_orders_summary.limit,
                do: "text-error",
                else: "text-primary"
              )
            }
            label={gettext("Órdenes usadas")}
          />
          {gettext("%{count} de %{limit} órdenes",
            count: @my_orders_summary.count,
            limit: @my_orders_summary.limit
          )}
        </span>
        <span>
          <.term name={:escrow} align="end">{gettext("escrow")}</.term>
          {Format.compact(@my_orders_summary.escrow)}
        </span>
        <span>
          {gettext("en venta %{value}", value: Format.compact(@my_orders_summary.sell_value))}
        </span>
      </div>
    </:actions>

    <p :if={is_nil(@my_orders)} id="my-orders-missing" class="text-sm eth-muted">
      {gettext(
        "Para seguir tus órdenes, agregá el permiso esi-markets.read_character_orders.v1 a tu aplicación de EVE y volvé a iniciar sesión."
      )}
    </p>
    <p :if={@my_orders == []} class="text-sm eth-muted">
      {gettext("No tenés órdenes abiertas.")}
    </p>

    <div :if={@my_orders not in [nil, []]} class="-mx-4 -mb-4 overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr class="border-base-300">
            <th class="eth-kicker text-[11px]">{gettext("Objeto")}</th>
            <th class="eth-kicker text-[11px]">{gettext("Lado")}</th>
            <th class="eth-kicker text-right text-[11px]">{gettext("Precio")}</th>
            <th class="eth-kicker text-right text-[11px]">{gettext("Restan")}</th>
            <th class="eth-kicker text-[11px]">{gettext("Estado")}</th>
            <th class="eth-kicker text-right text-[11px]">{gettext("Precio sugerido")}</th>
            <th class="eth-kicker text-right text-[11px]">
              <span class="flex items-center justify-end gap-1.5">
                {gettext("Costo de modificar")}
                <.help topic={:relist} title={gettext("Relist")} align="end">
                  {gettext(
                    "Modificar el precio de una orden cobra una parte del broker fee otra vez."
                  )}
                </.help>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr :for={o <- @my_orders} id={"my-order-#{o.order_id}"} class="border-base-300/60">
            <td class="font-semibold eth-strong">{o.type_name}</td>
            <td class="text-xs uppercase tracking-wider eth-muted">
              {if o.buy, do: gettext("compra"), else: gettext("venta")}
            </td>
            <td class="text-right font-mono">{Format.compact(o.price)}</td>
            <td class="text-right font-mono">{Format.integer(o.volume_remain)}</td>
            <td>
              <.seal
                kind={if o.status == :outbid, do: :risk, else: :improved}
                label={if o.status == :outbid, do: gettext("superada"), else: gettext("primera")}
              />
            </td>
            <td class="text-right">
              <button
                :if={o.suggested_price}
                id={"copy-order-#{o.order_id}"}
                type="button"
                phx-hook=".CopyPrice"
                data-text={price_text(o.suggested_price)}
                class="btn btn-ghost btn-xs font-mono"
                title={gettext("Copiar precio")}
              >
                {price_text(o.suggested_price)}
                <.icon name="hero-clipboard-document" class="size-3" />
              </button>
            </td>
            <td class="text-right font-mono">
              {o.relist_fee && Format.compact(o.relist_fee)}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </.panel>

  <section
    id="station-board"
    aria-labelledby="station-title"
    class="eth-chamfer border border-base-300 bg-base-100"
    phx-window-keydown="close_detail"
    phx-key="Escape"
  >
    <%!-- Barra de filtros acoplada a la tabla (RF-6.4) --%>
    <.form
      for={@form}
      id="station-filters"
      phx-change="filter"
      phx-submit="filter"
      class="flex flex-col gap-2 border-b border-base-300 p-3"
    >
      <div class="flex flex-wrap items-center gap-2">
        <h2 id="station-title" class="sr-only">{gettext("Oportunidades en estación")}</h2>
        <.filter_search
          field={@form[:search]}
          placeholder={gettext("Objeto o estación")}
          class="min-w-56 flex-1"
        />
        <label
          for="station-filters-more"
          class="btn btn-ghost btn-sm h-8 min-h-8 border-base-300 md:hidden"
        >
          <.icon name="hero-adjustments-horizontal" class="size-4" /> {gettext("Filtros")}
        </label>
        <.filter_field
          field={@form[:location_id]}
          type="select"
          label={gettext("Hub")}
          term={:hub}
          options={[{gettext("Todos los hubs"), ""} | @hubs]}
          class="max-w-80"
        />
        <.filter_field
          field={@form[:sort]}
          type="select"
          label={gettext("Orden")}
          options={[
            {gettext("Beneficio × Certeza"), "score"},
            {gettext("Beneficio por día"), "profit_day"},
            {gettext("Margen"), "margin"},
            {gettext("Volumen diario"), "volume"},
            {gettext("Frescura"), "age"}
          ]}
        />
        <span :if={@pending > 0} class="border border-warning/60 px-2 py-1 text-xs text-warning">
          {ngettext("%{count} cambio pendiente", "%{count} cambios pendientes", @pending)}
        </span>
      </div>
      <input
        type="checkbox"
        id="station-filters-more"
        class="peer sr-only"
        aria-label={gettext("Mostrar más filtros")}
      />
      <div class="hidden flex-wrap items-center gap-2 peer-checked:flex md:flex">
        <.filter_field
          field={@form[:min_margin]}
          type="number"
          min="0"
          step="0.5"
          label={gettext("Margen ≥ %")}
          phx-debounce="400"
          class="w-28 min-[100rem]:w-36"
        />
        <.filter_field
          field={@form[:min_daily_volume]}
          type="number"
          min="0"
          label={gettext("Volumen/día ≥")}
          phx-debounce="400"
          class="w-38 min-[100rem]:w-44"
        />
        <.filter_field
          field={@form[:capital]}
          label={gettext("Capital")}
          placeholder={gettext("sin límite")}
          phx-debounce="400"
          class="w-38 min-[100rem]:w-44"
        />
        <.filter_field
          field={@form[:accounting]}
          type="select"
          label="Accounting"
          term={:accounting}
          class="max-[100rem]:w-30"
          options={for level <- 0..5, do: {"#{level}", "#{level}"}}
        />
        <.filter_field
          field={@form[:broker_relations]}
          type="select"
          label="Broker Relations"
          term={:broker_relations}
          class="max-[100rem]:w-38"
          options={for level <- 0..5, do: {"#{level}", "#{level}"}}
        />
        <.filter_field
          field={@form[:shield]}
          type="select"
          label={gettext("Anti-scam")}
          term={:scam}
          options={[
            {gettext("Ocultar SCAM"), "hide_scam"},
            {gettext("Solo seguras"), "safe"},
            {gettext("Mostrar todo"), "all"}
          ]}
        />
        <button
          type="button"
          phx-click="reset_filters"
          title={gettext("Restablecer filtros")}
          aria-label={gettext("Restablecer filtros")}
          class="btn btn-ghost btn-sm h-8 min-h-8 eth-muted max-[100rem]:px-2"
        >
          <.icon name="hero-arrow-uturn-left" class="size-4" />
          <span class="max-[100rem]:hidden">{gettext("Restablecer")}</span>
        </button>
      </div>
    </.form>

    <%!-- Encabezado de columnas --%>
    <div class={[
      grid_class(),
      "border-b border-base-300 bg-base-200/60 py-2 eth-kicker text-[10px] tracking-[0.14em] max-md:hidden"
    ]}>
      <span>{gettext("Objeto")}</span>
      <span class="hidden md:block">{gettext("Estación")}</span>
      <span class="hidden items-center justify-end gap-1 md:flex">
        {gettext("Compra → Venta")}
        <.help topic={:station} title={gettext("Precios sugeridos")}>
          {gettext(
            "Tu orden de compra supera a la mejor compra y tu orden de venta a la mejor venta, con precios legales."
          )}
        </.help>
      </span>
      <span class="hidden text-right md:block">{gettext("Margen")}</span>
      <span class="hidden items-center justify-end gap-1 lg:flex">
        {gettext("Vol./día")}
        <.help topic={:liquidity} title={gettext("Volumen")} align="end">
          {gettext("Unidades operadas por día en la región (promedio de 7 días).")}
        </.help>
      </span>
      <span class="text-right">{gettext("Beneficio/día")}</span>
      <span class="flex items-center justify-end gap-1">
        <span class="hidden md:inline">{gettext("Certeza")}</span>
        <.help topic={:competition} title={gettext("Certeza")} align="end">
          {gettext("Baja con la competencia cerca del precio, los datos viejos y el escudo.")}
        </.help>
      </span>
      <span class="hidden md:block"></span>
    </div>

    <div id="station-rows" phx-update="stream">
      <div id="station-empty" class="hidden px-4 py-12 text-center eth-muted only:block">
        {gettext(
          "Sin oportunidades con estos filtros. El historial de los hubs se descarga de a poco: puede tardar unos minutos en aparecer."
        )}
      </div>
      <div
        :for={{dom_id, row} <- @streams.rows}
        id={dom_id}
        class={[
          "border-b border-base-300/70 last:border-b-0",
          RowChanges.class(@flashes[row.id]),
          @selected == row.id && "shadow-[inset_3px_0_0_var(--color-primary)]"
        ]}
      >
        <div
          data-head
          role="button"
          tabindex="0"
          aria-expanded={to_string(@selected == row.id)}
          phx-click="select"
          phx-value-id={row.id}
          class={[
            grid_class(),
            "relative cursor-pointer py-2.5 transition-colors hover:bg-primary/5 phx-click-loading:cursor-wait phx-click-loading:bg-primary/10",
            @selected == row.id && "bg-primary/10"
          ]}
        >
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <.type_icon
                id={"icon-#{row.id}"}
                type_id={row.opportunity.type_id}
                class="max-sm:hidden"
              />
              <span class="line-clamp-2 font-semibold eth-strong md:truncate">
                {row.opportunity.type_name}
              </span>
            </div>
            <div class="mt-0.5 flex flex-wrap gap-1">
              <.seal kind={:order} />
              <.shield_seal shield={row.shield} />
            </div>
          </div>
          <div class="hidden truncate text-sm md:block" title={row.opportunity.location.name}>
            {short_name(row.opportunity.location.name)}
          </div>
          <div class="hidden text-right md:block">
            <div class="font-mono text-sm">
              {Format.compact(row.quote.buy_price)} → {Format.compact(row.quote.sell_price)}
            </div>
            <div class="font-mono text-xs eth-faint">
              {gettext("competencia %{bids}/%{asks}",
                bids: row.quote.competition.bids,
                asks: row.quote.competition.asks
              )}
            </div>
          </div>
          <div class="hidden text-right font-mono font-medium eth-strong md:block">
            {pct(row.margin_pct)}
          </div>
          <div class="hidden text-right font-mono text-sm lg:block">
            {Format.compact(row.daily_volume)}
          </div>
          <div class="text-right">
            <div class="font-mono text-base font-medium text-accent">
              {Format.compact(row.profit_day)}
            </div>
            <div class="font-mono text-xs eth-faint">
              {gettext("inv.")} {Format.compact(row.cost)}
            </div>
          </div>
          <div class="flex justify-end"><.certainty_ring value={row.certainty} /></div>
          <div class="hidden justify-end md:flex">
            <.icon
              name="hero-chevron-down"
              class={[
                "size-4 eth-muted transition-transform duration-200 phx-click-loading:hidden",
                @selected == row.id && "rotate-180 text-primary"
              ]}
            />
            <span class="hidden phx-click-loading:inline-flex"><.spinner size={16} /></span>
          </div>
          <span
            aria-hidden="true"
            class="eth-row-loading pointer-events-none absolute inset-x-0 bottom-0 hidden h-0.5 phx-click-loading:block"
          ></span>
        </div>

        <%!-- Ficha bajo la fila (RF-6.5, RF-6.12) --%>
        <.row_detail
          :if={@selected == row.id}
          id="station-detail"
          label={gettext("Ficha de %{name}", name: row.opportunity.type_name)}
        >
          <div
            :if={row.shield.status != :ok}
            id="station-shield-alert"
            role={if row.shield.status == :scam, do: "alert", else: "status"}
            class={[
              "border px-3 py-2 text-sm md:col-span-2 xl:col-span-4",
              if(row.shield.status == :scam,
                do: "border-error/50 bg-error/10 text-error",
                else: "border-warning/50 bg-warning/10 text-warning"
              )
            ]}
          >
            <span class="font-semibold">{shield_label(row.shield.status)}</span>
            <span class="eth-muted">· {Enum.join(row.shield.reasons, " · ")}</span>
          </div>

          <.detail_col
            title={gettext("Precios sugeridos")}
            topic={:station}
            help={gettext("Precios legales de 4 cifras significativas que te ponen primero.")}
          >
            <p class="mb-2 text-xs eth-muted">{row.opportunity.location.name}</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="eth-chamfer-sm border border-base-300 bg-base-100 p-2.5">
                <div class="eth-kicker text-[10px]">{gettext("Orden de compra")}</div>
                <div class="font-mono text-base eth-strong">
                  {price_text(row.quote.buy_price)}
                </div>
                <button
                  id="copy-buy-price"
                  type="button"
                  data-shortcut="copy"
                  phx-hook=".CopyPrice"
                  data-text={price_text(row.quote.buy_price)}
                  class="btn btn-ghost btn-xs -ml-2"
                >
                  <.icon name="hero-clipboard-document" class="size-4" /> {gettext("Copiar")}
                </button>
              </div>
              <div class="eth-chamfer-sm border border-base-300 bg-base-100 p-2.5">
                <div class="eth-kicker text-[10px]">{gettext("Orden de venta")}</div>
                <div class="font-mono text-base eth-strong">
                  {price_text(row.quote.sell_price)}
                </div>
                <button
                  id="copy-sell-price"
                  type="button"
                  phx-hook=".CopyPrice"
                  data-text={price_text(row.quote.sell_price)}
                  class="btn btn-ghost btn-xs -ml-2"
                >
                  <.icon name="hero-clipboard-document" class="size-4" /> {gettext("Copiar")}
                </button>
              </div>
            </div>
            <p class="mt-1.5 text-xs eth-faint">
              {gettext("Superan a la mejor compra (%{bid}) y a la mejor venta (%{ask}).",
                bid: Format.compact(row.quote.best_bid),
                ask: Format.compact(row.quote.best_ask)
              )}
            </p>
          </.detail_col>

          <.detail_col title={gettext("Cálculo por unidad")} topic={:broker}>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm tabular-nums">
              <dt class="eth-muted">{gettext("Broker fee")}</dt>
              <dd class="text-right font-mono">
                <.tip title={gettext("Broker fee")} topic={:broker} align="end">
                  {pct2(row.broker_rate)}
                  <:body>
                    {gettext(
                      "Se paga al publicar cada orden (la de compra y la de venta). Baja con Broker Relations y los standings."
                    )}
                  </:body>
                </.tip>
                <span class="eth-faint">×2</span>
              </dd>
              <dt class="eth-muted">{gettext("Sales tax")}</dt>
              <dd class="text-right font-mono">{pct2(row.tax_rate)}</dd>
              <dt class="eth-muted">{gettext("Costo")}</dt>
              <dd class="text-right font-mono">{Format.compact(row.quote.unit_cost)}</dd>
              <dt class="eth-muted">{gettext("Ingreso neto")}</dt>
              <dd class="text-right font-mono">{Format.compact(row.quote.unit_revenue)}</dd>
              <div class="col-span-2 my-1 border-t border-base-300"></div>
              <dt class="eth-muted">{gettext("Margen")}</dt>
              <dd class="text-right font-mono font-semibold text-accent">
                {Format.compact(row.quote.unit_margin)} · {pct(row.margin_pct)}
              </dd>
            </dl>
          </.detail_col>

          <.detail_col
            title={gettext("Plan diario")}
            topic={:station}
            help={gettext("Lo que podés mover en un día sin llevarte todo el volumen.")}
          >
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm tabular-nums">
              <dt class="eth-muted">{gettext("Volumen diario (7 d)")}</dt>
              <dd class="text-right font-mono">{Format.integer(round(row.daily_volume))}</dd>
              <dt class="eth-muted">{gettext("Cantidad objetivo")}</dt>
              <dd class="text-right font-mono">{Format.integer(row.plan.quantity)}</dd>
              <dt class="eth-muted">{gettext("ISK inmovilizado")}</dt>
              <dd class="text-right font-mono">{Format.compact(row.plan.cost)}</dd>
              <div class="col-span-2 my-1 border-t border-base-300"></div>
              <dt class="eth-muted">
                {gettext("Beneficio por día")}
              </dt>
              <dd class="text-right font-mono font-semibold text-accent">
                {Format.compact(row.profit_day)}
              </dd>
            </dl>
            <p class="mt-1.5 text-xs eth-faint">
              {gettext("Estimación: depende de la competencia.")}
            </p>
          </.detail_col>

          <.detail_col
            title={gettext("¿Por qué Certeza %{c}?", c: pct(row.certainty))}
            topic={:competition}
          >
            <ul class="space-y-0.5 text-xs tabular-nums">
              <li class="flex justify-between gap-3">
                <span class="eth-muted">
                  {gettext("Competencia (%{bids} compras y %{asks} ventas cerca)",
                    bids: row.quote.competition.bids,
                    asks: row.quote.competition.asks
                  )}
                </span>
                <span class="font-mono">{pct(row.breakdown.competition_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Frescura de datos")}</span>
                <span class="font-mono">{pct(row.breakdown.data_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Anti-scam")}</span>
                <span class="font-mono">{pct(row.breakdown.scam_certainty)}</span>
              </li>
            </ul>
          </.detail_col>

          <:footer>
            <button
              id="station-open-market"
              type="button"
              phx-click="open_market"
              disabled={is_nil(@pilot)}
              class="eth-chamfer-sm btn btn-accent btn-sm px-5 font-display tracking-wide"
            >
              <.icon name="hero-building-storefront" class="size-4" /> {gettext("Abrir mercado")}
            </button>
            <span class="text-xs eth-faint">
              {gettext(
                "ESI no permite publicar órdenes: la aplicación sugiere los precios y la orden la publicás vos en el juego."
              )}
            </span>
            <button
              type="button"
              phx-click="close_detail"
              class="btn btn-ghost btn-sm ml-auto eth-muted"
            >
              <.icon name="hero-chevron-up" class="size-4" /> {gettext("Cerrar")}
              <kbd class="kbd kbd-xs">Esc</kbd>
            </button>
          </:footer>
        </.row_detail>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-base-300 px-4 py-2 text-xs eth-faint">
      <span id="station-hint">
        {gettext(
          "Comprás con una orden de compra y vendés con una de venta en la misma estación. El beneficio por día es una estimación: depende de la competencia."
        )}
      </span>
      <span>
        {gettext("máx. 200 filas")} ·
        <.link navigate={EthWeb.Docs.href(:station)} class="link link-primary">
          {gettext("Cómo funciona el station trading")}
        </.link>
      </span>
    </div>
  </section>

  <.board_shortcuts />

  <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyPrice">
    export default {
      mounted() {
        this.el.addEventListener("click", (event) => {
          event.stopPropagation()
          navigator.clipboard.writeText(this.el.dataset.text).then(() => this.pushEvent("copied", {}))
        })
      }
    }
  </script>
</Layouts.app>
