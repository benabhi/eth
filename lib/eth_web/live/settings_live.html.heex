<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:settings}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-3 font-display text-2xl font-semibold eth-strong sm:text-[26px]">
      {gettext("Ajustes")}
      <.help topic={:settings} title={gettext("Ajustes")} align="start">
        {gettext(
          "Personajes, naves, reglas del juego, radar, mercados, alertas y primer arranque."
        )}
      </.help>
    </h1>
  </div>

  <.tabs
    id="settings-tabs"
    active={to_string(@live_action)}
    label={gettext("Secciones de ajustes")}
    tabs={for {id, {label, path}} <- @tabs, do: {to_string(id), label, path}}
  />

  <%!-- Personajes (RF-9.2) --%>
  <section :if={@live_action == :characters} id="settings-characters" class="space-y-3">
    <p class="text-sm eth-muted">
      {gettext(
        "Cada personaje mantiene su sesión con EVE; los que no están activos consultan ESI con menos frecuencia."
      )}
    </p>

    <.empty_state
      :if={@rows == []}
      id="characters-empty"
      title={gettext("Todavía no vinculaste ningún personaje.")}
    >
      {gettext("Iniciá sesión con EVE para ver tu billetera, tu nave y tus impuestos reales.")}
      <:actions>
        <a href={~p"/auth/eve"} class="btn btn-primary btn-sm">
          {gettext("Iniciar sesión con EVE")}
        </a>
      </:actions>
    </.empty_state>

    <div class="grid gap-3 xl:grid-cols-2">
      <article
        :for={row <- @rows}
        id={"character-#{row.character.id}"}
        class={[
          "eth-chamfer border bg-base-100 p-4",
          if(@pilot && @pilot.id == row.character.id,
            do: "border-primary/60",
            else: "border-base-300"
          )
        ]}
      >
        <div class="flex flex-wrap items-start gap-4">
          <img
            src={row.portrait_url}
            alt=""
            width="64"
            height="64"
            class="eth-chamfer-sm size-16 bg-base-300"
          />
          <div class="min-w-0 flex-1 space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-display text-lg font-semibold eth-strong">{row.character.name}</h2>
              <.seal
                :if={@pilot && @pilot.id == row.character.id}
                kind={:new}
                label={gettext("activo")}
              />
              <span class={["badge badge-sm", status_class(row.session)]}>
                {status_label(row.session, row.character)}
              </span>
            </div>
            <p :if={row.session} class="text-xs eth-muted">{mode_label(row.session.mode)}</p>
            <p class="font-mono text-xs eth-faint">
              {gettext("Último login")}: {row.character.last_login_at &&
                Calendar.strftime(row.character.last_login_at, "%Y-%m-%d %H:%M UTC")}
            </p>
            <p :if={row.missing_scopes == []} class="text-xs text-success">
              {gettext("Concedió todos los permisos que usa la aplicación.")}
            </p>
            <div :if={row.missing_scopes != []} class="text-xs text-warning">
              {gettext("Faltan permisos (volvé a iniciar sesión para concederlos):")}
              <ul class="ml-4 list-disc font-mono">
                <li :for={scope <- row.missing_scopes}>{scope}</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2 border-t border-base-300 pt-3">
          <.link
            :if={!(@pilot && @pilot.id == row.character.id)}
            id={"settings-activate-#{row.character.id}"}
            href={~p"/auth/characters/#{row.character.id}/activate"}
            method="post"
            class="btn btn-primary btn-sm"
          >
            {gettext("Activar")}
          </.link>
          <a href={~p"/auth/eve"} class="btn btn-sm">{gettext("Volver a iniciar sesión")}</a>
          <button
            id={"forget-#{row.character.id}"}
            type="button"
            phx-click="forget"
            phx-value-id={row.character.id}
            data-confirm={
              gettext(
                "¿Olvidar a %{name}? Se revoca su autorización en EVE y se borra de la aplicación.",
                name: row.character.name
              )
            }
            class="btn btn-error btn-outline btn-sm ml-auto"
          >
            {gettext("Olvidar")}
          </button>
        </div>
      </article>
    </div>

    <a :if={@rows != []} href={~p"/auth/eve"} class="btn btn-sm">
      <.icon name="hero-user-plus" class="size-4" /> {gettext("Agregar personaje")}
    </a>
  </section>

  <%!-- Naves (RF-9.3) --%>
  <section :if={@live_action == :ships} id="settings-ships" class="space-y-3">
    <.empty_state
      :if={@profiles == []}
      id="ships-empty"
      title={gettext("No hay perfiles de carga guardados.")}
    >
      {gettext(
        "Con el permiso de assets la bodega se calcula sola; el perfil manual se usa cuando no se pueden leer los módulos."
      )}
    </.empty_state>

    <.panel
      :if={@profiles != []}
      id="ships-panel"
      title={gettext("Perfiles de carga")}
      help={:ship_profile}
    >
      <:help_body>
        {gettext(
          "Perfiles guardados a mano. Con el permiso de assets la bodega se calcula sola; el perfil manual se usa cuando no se pueden leer los módulos."
        )}
      </:help_body>
      <div class="-mx-4 -mb-4 overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr class="border-base-300">
              <th class="eth-kicker text-[10px]">{gettext("Nave")}</th>
              <th class="eth-kicker text-[10px]">{gettext("Aplica a")}</th>
              <th class="eth-kicker text-right text-[10px]">{gettext("Bodega")}</th>
              <th class="eth-kicker text-[10px]">{gettext("Clase de evasión")}</th>
              <th class="eth-kicker text-right text-[10px]">{gettext("Valor máx.")}</th>
              <th><span class="sr-only">{gettext("Acciones")}</span></th>
            </tr>
          </thead>
          <tbody id="ship-profiles">
            <%= for row <- @profiles do %>
              <tr id={"profile-#{row.profile.id}"} class="border-base-300/60">
                <td>
                  <div class="flex items-center gap-2">
                    <img
                      src={Pilot.ship_render_url(row.profile.ship_type_id, 32)}
                      alt=""
                      width="28"
                      height="28"
                      class="size-7 bg-base-300"
                    />
                    <span class="font-semibold eth-strong">{row.type_name}</span>
                  </div>
                </td>
                <td class="text-sm eth-muted">
                  <%= if row.profile.ship_item_id do %>
                    {gettext("Esta nave (#%{id})", id: row.profile.ship_item_id)}
                  <% else %>
                    {gettext("Todas las %{ship} sin perfil propio", ship: row.type_name)}
                  <% end %>
                </td>
                <td class="text-right font-mono">
                  {Format.integer(round(row.profile.cargo_m3))} m³
                </td>
                <td>{evasion_label(row.profile.evasion_class)}</td>
                <td class="text-right font-mono">
                  {Format.compact(row.profile.max_cargo_value)}
                </td>
                <td class="text-right">
                  <button
                    id={"edit-profile-#{row.profile.id}"}
                    type="button"
                    phx-click="edit_ship"
                    phx-value-id={row.profile.id}
                    class="btn btn-ghost btn-xs"
                  >
                    {gettext("Editar")}
                  </button>
                  <button
                    id={"delete-profile-#{row.profile.id}"}
                    type="button"
                    phx-click="delete_ship"
                    phx-value-id={row.profile.id}
                    data-confirm={gettext("¿Borrar este perfil de carga?")}
                    class="btn btn-ghost btn-xs text-error"
                  >
                    {gettext("Borrar")}
                  </button>
                </td>
              </tr>
              <tr
                :if={@editing == row.profile.id}
                id={"profile-edit-#{row.profile.id}"}
                class="bg-base-200/70"
              >
                <td colspan="6" class="eth-unfold">
                  <.form
                    for={@ship_edit_form}
                    id="ship-edit-form"
                    phx-change="validate_ship"
                    phx-submit="save_ship"
                    class="grid grid-cols-1 items-end gap-x-3 sm:grid-cols-4"
                  >
                    <.input
                      field={@ship_edit_form[:cargo_m3]}
                      type="number"
                      step="any"
                      min="0"
                      label={gettext("Bodega general (m³)")}
                    />
                    <.input
                      field={@ship_edit_form[:evasion_class]}
                      type="select"
                      label={gettext("Clase de evasión")}
                      options={evasion_options()}
                    />
                    <.input
                      field={@ship_edit_form[:max_cargo_value]}
                      type="number"
                      step="any"
                      min="0"
                      label={gettext("Valor máx. de carga")}
                    />
                    <div class="mb-2 flex gap-2">
                      <button id="ship-edit-save" type="submit" class="btn btn-primary btn-sm">
                        {gettext("Guardar")}
                      </button>
                      <button type="button" phx-click="cancel_edit" class="btn btn-ghost btn-sm">
                        {gettext("Cancelar")}
                      </button>
                    </div>
                  </.form>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </.panel>
  </section>

  <%!-- Reglas de mercado (RF-9.4) --%>
  <section :if={@live_action == :rules} id="settings-rules" class="space-y-3">
    <.form for={@rules_form} id="rules-form" phx-submit="save_rules">
      <.panel id="rules-panel" title={gettext("Reglas del mercado")} help={:sales_tax}>
        <:help_body>
          {gettext(
            "Valores del juego que CCP puede cambiar. Dejá el campo vacío para usar el valor por defecto."
          )}
        </:help_body>
        <:actions>
          <span :if={@verified_on} class="text-xs eth-faint">
            {gettext("Valores por defecto verificados el %{date}.",
              date: Date.to_iso8601(@verified_on)
            )}
          </span>
        </:actions>
        <div class="-mx-4 -mt-4 overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr class="border-base-300">
                <th class="eth-kicker text-[10px]">{gettext("Regla")}</th>
                <th class="eth-kicker text-right text-[10px]">{gettext("Por defecto")}</th>
                <th class="eth-kicker w-48 text-[10px]">{gettext("Override (%)")}</th>
                <th><span class="sr-only">{gettext("Acciones")}</span></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={rule <- @rules} id={"rule-#{rule.key}"} class="border-base-300/60">
                <td>
                  <div class="eth-strong">{rule.label}</div>
                  <div class="font-mono text-xs eth-faint">{rule.key}</div>
                </td>
                <td class="text-right font-mono">{pct(rule.default)}</td>
                <td>
                  <.input
                    field={@rules_form[Atom.to_string(rule.key)]}
                    placeholder={percent_input(rule.default)}
                    inputmode="decimal"
                  />
                </td>
                <td class="text-right">
                  <button
                    :if={rule.override}
                    id={"reset-#{rule.key}"}
                    type="button"
                    phx-click="reset_rule"
                    phx-value-key={rule.key}
                    class="btn btn-ghost btn-xs"
                  >
                    {gettext("Restablecer")}
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="-mx-4 -mb-4 mt-0 flex items-center gap-3 border-t border-base-300 px-4 py-3">
          <button id="rules-save" type="submit" class="btn btn-primary btn-sm">
            {gettext("Guardar reglas")}
          </button>
          <span class="text-xs eth-faint">
            {gettext("Guardar vuelve a evaluar el mercado con los valores nuevos.")}
          </span>
        </div>
      </.panel>
    </.form>
  </section>

  <%!-- Radar (RF-9.5) --%>
  <%!-- Parámetros del motor y del riesgo (RF-9.5) --%>
  <section :if={@live_action == :engine} id="settings-engine" class="space-y-4">
    <.form for={@engine_form} id="engine-form" phx-submit="save_engine" class="space-y-4">
      <%= for group <- @engine_groups do %>
        <.panel id={"engine-#{group.id}"} title={group.title} help={:settings}>
          <:help_body>{group.help}</:help_body>

          <%= if group.id == :vulnerability do %>
            <div class="-mx-4 -mt-4 overflow-x-auto">
              <table class="table table-sm">
                <thead>
                  <tr class="border-base-300">
                    <th class="eth-kicker text-[10px]">{gettext("Clase de nave")}</th>
                    <th :for={t <- Tunable.threats()} class="eth-kicker text-[10px]">
                      {Tunable.threat_label(t)} (%)
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    :for={class <- Tunable.ship_classes()}
                    id={"vuln-#{class}"}
                    class="border-base-300/60"
                  >
                    <td class="eth-strong">{Tunable.ship_class_label(class)}</td>
                    <td :for={t <- Tunable.threats()} class="min-w-24">
                      <% row =
                        Enum.find(group.rows, &(&1.entry.path == [:vulnerability, class, t])) %>
                      <.input
                        field={@engine_form[row.entry.key]}
                        placeholder={row.placeholder}
                        inputmode="decimal"
                        class={[
                          "input input-sm w-full font-mono",
                          row.custom? && "border-primary"
                        ]}
                      />
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="mt-2 text-xs eth-faint">
              {gettext(
                "Freighter: carguero enorme y lento. Deep Space Transport: transporte blindado. Blockade Runner: transporte que se camufla. Shuttle: lanzadera rápida. Vacío: valor por defecto (el gris); un campo con borde de color tiene un valor propio."
              )}
            </p>
          <% else %>
            <div class="-mx-4 -mt-4 overflow-x-auto">
              <table class="table table-sm">
                <tbody>
                  <tr
                    :for={row <- group.rows}
                    id={"param-#{row.dom_id}"}
                    class="border-base-300/60"
                  >
                    <td>
                      <div class="eth-strong">{row.entry.label}</div>
                      <div class="text-xs eth-faint">{row.entry.help}</div>
                    </td>
                    <td class="w-48">
                      <%= if row.entry.kind == :boolean do %>
                        <.input
                          field={@engine_form[row.entry.key]}
                          type="select"
                          options={[
                            {gettext("Por defecto (%{v})", v: row.default_text), ""},
                            {gettext("Sí"), "true"},
                            {gettext("No"), "false"}
                          ]}
                        />
                      <% else %>
                        <.input
                          field={@engine_form[row.entry.key]}
                          placeholder={row.placeholder}
                          inputmode="decimal"
                        />
                      <% end %>
                    </td>
                    <td class="w-8 font-mono text-xs eth-faint">{unit(row.entry)}</td>
                    <td class="w-24 text-right">
                      <button
                        :if={row.custom?}
                        id={"reset-param-#{row.dom_id}"}
                        type="button"
                        phx-click="reset_engine_param"
                        phx-value-key={row.entry.key}
                        class="btn btn-ghost btn-xs"
                      >
                        {gettext("Restablecer")}
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          <% end %>
        </.panel>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <button id="engine-save" type="submit" class="btn btn-primary btn-sm">
          {gettext("Guardar parámetros")}
        </button>
        <span class="text-xs eth-faint">
          {gettext(
            "Vacío = valor por defecto (el que se ve en gris). Guardar vuelve a evaluar el mercado."
          )}
        </span>
      </div>
    </.form>
  </section>

  <section :if={@live_action == :radar} id="settings-radar" class="space-y-3">
    <.panel id="radar-panel" title={gettext("Radar y rutas")} help={:evasive}>
      <:help_body>
        {gettext(
          "El modo Evasiva suma α × amenaza al costo de cada sistema en alerta; los sistemas a evitar se sacan del camino en todos los modos."
        )}
      </:help_body>
      <p class="mb-3 text-sm eth-muted">
        {gettext(
          "El modo de ruta Evasiva suma α × amenaza al costo de cada sistema en alerta: con α más alto acepta desvíos más largos para esquivar camps y ganks. Los sistemas a evitar se sacan del camino en todos los modos (salvo si son el origen o el destino)."
        )}
      </p>
      <.form for={@radar_form} id="radar-form" phx-submit="save_radar" class="space-y-2">
        <div class="w-48">
          <.input
            field={@radar_form[:evasive_alpha]}
            label={gettext("α del modo Evasiva")}
            placeholder={"#{@alpha_default}"}
            inputmode="decimal"
          />
        </div>
        <.input
          field={@radar_form[:avoid]}
          type="textarea"
          label={gettext("Sistemas a evitar")}
          placeholder="Uedama, Niarja, Sivala"
        />
        <p class="text-xs eth-faint">
          {gettext(
            "Nombres exactos separados por comas o renglones. Vacío: no se evita ninguno. α vacío: %{alpha} (por defecto).",
            alpha: @alpha_default
          )}
        </p>
        <button id="radar-save" type="submit" class="btn btn-primary btn-sm">
          {gettext("Guardar radar")}
        </button>
      </.form>
    </.panel>
  </section>

  <%!-- Notificaciones (RF-10.2, RF-10.3) --%>
  <section
    :if={@live_action == :notifications}
    id="settings-notifications"
    class="grid gap-4 lg:grid-cols-2"
  >
    <.panel id="browser-panel" title={gettext("En este navegador")}>
      <p class="text-sm eth-muted">
        {gettext(
          "Las alertas siempre aparecen dentro de la app. Además podés recibirlas como notificación del sistema y con un sonido corto, útil con el juego en primer plano. Se guarda en este navegador."
        )}
      </p>
      <p id="notify-status" class="mt-3 text-sm font-semibold eth-strong">
        {gettext("Notificaciones del navegador: cargando…")}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button
          id="notify-enable"
          type="button"
          phx-click={JS.dispatch("eth:notify-permission")}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-bell-alert" class="size-4" /> {gettext("Activar notificaciones")}
        </button>
        <button
          id="notify-disable"
          type="button"
          phx-click={JS.dispatch("eth:notify-disable")}
          class="btn btn-sm"
        >
          {gettext("Desactivar")}
        </button>
        <button
          id="notify-sound"
          type="button"
          phx-click={JS.dispatch("eth:notify-sound")}
          class="btn btn-sm"
        >
          <.icon name="hero-speaker-wave" class="size-4" /> {gettext(
            "Activar o desactivar sonido"
          )}
        </button>
        <button id="notify-test" type="button" phx-click="test_alert" class="btn btn-ghost btn-sm">
          {gettext("Probar")}
        </button>
      </div>
    </.panel>

    <.panel id="rule-panel" title={gettext("Contratos nuevos")}>
      <p class="text-sm eth-muted">
        {gettext(
          "Avisa cuando aparece un contrato que no estaba en la evaluación anterior y supera estos mínimos (con los parámetros del modo invitado). Como mucho 3 por evaluación; el mismo contrato no vuelve a sonar antes de 10 minutos."
        )}
      </p>
      <.form
        for={@rule_form}
        id="rule-form"
        phx-submit="save_rule"
        class="mt-3 flex flex-wrap items-end gap-3 [&_.fieldset]:mb-0"
      >
        <%!-- Casilla y botón en una caja del alto de los campos: todo queda alineado. --%>
        <div class="flex h-10 items-center pt-0.5 pb-0.5 box-content">
          <.input field={@rule_form[:enabled]} type="checkbox" label={gettext("Activada")} />
        </div>
        <div class="w-32">
          <.input
            field={@rule_form[:min_tvs]}
            type="number"
            min="0"
            max="100"
            label={gettext("TVS ≥")}
          />
        </div>
        <div class="w-40">
          <.input
            field={@rule_form[:min_profit]}
            label={gettext("Beneficio ≥")}
            placeholder="20M"
          />
        </div>
        <div class="flex h-10 items-center pb-1 box-content">
          <button type="submit" class="btn btn-primary btn-sm">{gettext("Guardar")}</button>
        </div>
      </.form>
      <p class="text-xs eth-faint">
        {gettext(
          "Siempre avisan, sin configurar: eventos y amenazas de tu viaje activo, hitos del registro del cazador, órdenes superadas y tokens de EVE que requieren volver a loguear."
        )}
      </p>
    </.panel>
  </section>

  <%!-- Regiones y estructuras (RF-9.6) --%>
  <section :if={@live_action == :markets} id="settings-markets" class="space-y-4">
    <.panel id="regions-panel" title={gettext("Regiones habilitadas")} help={:pollers}>
      <:help_body>
        {gettext("El nivel decide la frecuencia cuando el presupuesto de ESI escasea.")}
      </:help_body>
      <p class="text-sm eth-muted">
        {gettext(
          "Se eligen con ETH_REGIONS en .env (vacío: todo el universo) y se aplican al reiniciar. El nivel decide la frecuencia cuando el presupuesto de ESI escasea."
        )}
      </p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        <span
          :for={r <- @regions}
          id={"region-#{r.region_id}"}
          class="border border-base-300 bg-base-200 px-2 py-0.5 text-xs"
        >
          <span class="eth-strong">{r.name}</span>
          <span class="eth-faint">· {tier_label(r.tier)}</span>
        </span>
      </div>
    </.panel>

    <.panel id="structures-panel" title={gettext("Estructuras")} help={:station}>
      <:help_body>
        {gettext(
          "Mercados de estructuras Upwell: públicas con más órdenes y privadas que agregues por ID."
        )}
      </:help_body>
      <:actions>
        <.form for={@add_form} id="structure-add" phx-submit="add_structure" class="flex gap-2">
          <label class="eth-filter w-72">
            <span class="eth-filter-label">{gettext("ID privada")}</span>
            <input
              type="text"
              id={@add_form[:id].id}
              name={@add_form[:id].name}
              value={@add_form[:id].value}
              inputmode="numeric"
              aria-label={gettext("Agregar por ID (privadas)")}
            />
          </label>
          <button type="submit" class="btn btn-sm h-8 min-h-8">{gettext("Agregar")}</button>
        </.form>
      </:actions>
      <p class="text-sm eth-muted">
        {gettext(
          "Se siguen las 30 públicas con más órdenes de las regiones habilitadas, más las que marques. El acceso se prueba con tus personajes; un 403 no se reintenta antes de 24 h."
        )}
      </p>

      <div class="-mx-4 mt-3 overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr class="border-base-300">
              <th class="eth-kicker text-[10px]">{gettext("Estructura")}</th>
              <th class="eth-kicker text-right text-[10px]">{gettext("Órdenes")}</th>
              <th class="eth-kicker text-[10px]">{gettext("Acceso")}</th>
              <th class="eth-kicker text-[10px]">{gettext("Seguida")}</th>
              <th class="eth-kicker w-44 text-[10px]">
                <.term name={:broker} align="end">{gettext("Broker fee (%)")}</.term>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={row <- @structures}
              id={"structure-#{row.structure.id}"}
              class="border-base-300/60"
            >
              <td>
                <div class="font-semibold eth-strong">
                  {row.structure.name || gettext("Sin resolver (%{id})", id: row.structure.id)}
                </div>
                <div class="flex items-center gap-1.5 text-xs eth-faint">
                  {if row.structure.public_market,
                    do: gettext("pública"),
                    else: gettext("privada")}
                  <.seal :if={row.selected} kind={:improved} label={gettext("en seguimiento")} />
                </div>
              </td>
              <td class="text-right font-mono">{Format.integer(row.structure.orders_count)}</td>
              <td class="text-xs">
                <span :if={row.access == %{}} class="eth-faint">{gettext("sin probar")}</span>
                <div :for={{cid, status} <- row.access}>
                  {Map.get(@character_names, cid, cid)}: {access_label(status)}
                </div>
              </td>
              <td>
                <input
                  type="checkbox"
                  class="toggle toggle-primary toggle-sm"
                  checked={row.structure.followed}
                  phx-click="toggle_follow"
                  phx-value-id={row.structure.id}
                  aria-label={gettext("Seguir siempre")}
                />
              </td>
              <td>
                <form phx-submit="save_broker_fee" class="flex gap-1">
                  <input type="hidden" name="structure_id" value={row.structure.id} />
                  <label class="eth-filter w-24">
                    <input
                      name="fee"
                      value={
                        row.structure.broker_fee_override &&
                          percent_input(row.structure.broker_fee_override)
                      }
                      placeholder={gettext("defecto")}
                      inputmode="decimal"
                      aria-label={gettext("Broker fee (%)")}
                    />
                  </label>
                  <button type="submit" class="btn btn-ghost btn-xs h-8">{gettext("Guardar")}</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs eth-faint">
        {gettext(
          "Una estructura con broker fee cargado se suma como lugar para publicar órdenes en Estación, Listado y Compra por orden, con esa comisión. En el arbitraje directo solo aplica el sales tax."
        )}
      </p>
    </.panel>
  </section>

  <%!-- Respaldo (RF-9.7) --%>
  <section :if={@live_action == :backup} id="settings-backup" class="grid gap-4 lg:grid-cols-2">
    <.panel id="export-panel" title={gettext("Exportar")}>
      <p class="text-sm eth-muted">
        {gettext(
          "Descarga un archivo JSON con tus ajustes: reglas, radar, alertas, perfiles de nave y estructuras seguidas. No incluye personajes, tokens ni claves: en otra instalación volvés a iniciar sesión con EVE."
        )}
      </p>
      <a
        id="config-export"
        href={~p"/settings/export"}
        download
        class="btn btn-primary btn-sm mt-4"
      >
        <.icon name="hero-arrow-down-tray" class="size-4" /> {gettext("Descargar configuración")}
      </a>
    </.panel>

    <.panel id="import-panel" title={gettext("Importar")}>
      <p class="text-sm eth-muted">
        {gettext(
          "Reemplaza cada sección que trae el archivo; lo que no viene queda como está. Los valores se validan igual que en cada pestaña."
        )}
      </p>
      <.form
        for={%{}}
        id="config-import"
        phx-change="validate_import"
        phx-submit="import"
        class="mt-4 flex flex-wrap items-center gap-2"
      >
        <label class="eth-filter min-w-60 flex-1 cursor-pointer">
          <span class="eth-filter-label">{gettext("Archivo")}</span>
          <.live_file_input
            upload={@uploads.config}
            class="file-input file-input-ghost file-input-xs w-full"
          />
        </label>
        <button
          type="submit"
          class="btn btn-sm h-8 min-h-8"
          disabled={@uploads.config.entries == []}
          phx-disable-with={gettext("Importando…")}
        >
          <.icon name="hero-arrow-up-tray" class="size-4" /> {gettext("Importar")}
        </button>
      </.form>
      <p
        :for={entry <- @uploads.config.entries}
        :if={upload_errors(@uploads.config, entry) != []}
        class="mt-2 text-xs text-error"
      >
        {gettext("Solo archivos .json de hasta 1 MB.")}
      </p>

      <div :if={@import_result} id="import-result" class="mt-4 text-sm">
        <%= case @import_result do %>
          <% {:ok, summary} -> %>
            <div class="border border-success/50 bg-success/10 px-3 py-2">
              <div class="font-semibold text-success">{gettext("Configuración importada")}</div>
              <div class="eth-muted">{Enum.join(summary.applied, " · ")}</div>
              <div :if={summary.skipped != []} class="mt-1 text-xs text-warning">
                {gettext("Descartados:")} {Enum.join(summary.skipped, ", ")}
              </div>
            </div>
          <% {:error, message} -> %>
            <div class="border border-error/50 bg-error/10 px-3 py-2 text-error">{message}</div>
        <% end %>
      </div>
    </.panel>
  </section>

  <%!-- Primer arranque (RF-9.1) --%>
  <section :if={@live_action == :setup} id="settings-setup" class="space-y-3">
    <% done = Enum.count(@checks, fn {_id, _title, ok, _hint} -> ok end) %>
    <.panel id="setup-panel" title={gettext("Primer arranque")} help={:first_steps}>
      <:help_body>
        {gettext("Lista de verificación para dejar la aplicación lista para operar.")}
      </:help_body>
      <:actions>
        <span class="flex items-center gap-2 text-xs eth-muted">
          <.ring
            value={done / max(length(@checks), 1)}
            size={28}
            stroke={3}
            class={if(done == length(@checks), do: "text-success", else: "text-primary")}
            label={gettext("Pasos completos")}
          />
          <span class="font-mono">{done}/{length(@checks)}</span>
        </span>
      </:actions>
      <ol class="-mx-4 -my-4 divide-y divide-base-300">
        <li
          :for={{{id, title, ok, hint}, i} <- Enum.with_index(@checks, 1)}
          id={"check-#{id}"}
          class="flex items-start gap-3 px-4 py-3"
          data-ok={to_string(ok)}
        >
          <span class={[
            "eth-chamfer-xs flex size-6 shrink-0 items-center justify-center border font-display text-xs",
            if(ok,
              do: "border-success bg-success/10 text-success",
              else: "border-base-300 eth-muted"
            )
          ]}>
            <%= if ok do %>
              <.icon name="hero-check" class="size-4" />
            <% else %>
              {i}
            <% end %>
          </span>
          <div>
            <div class={[if(ok, do: "eth-strong", else: "eth-muted")]}>{title}</div>
            <div :if={!ok} class="text-xs eth-faint">{hint}</div>
          </div>
        </li>
      </ol>
    </.panel>
  </section>
</Layouts.app>
