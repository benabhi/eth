<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:control}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex items-center gap-3 font-display text-2xl font-semibold eth-strong sm:text-[26px]">
      {gettext("Centro de control")}
      <.help topic={:control} title={gettext("Centro de control")} align="start">
        {gettext(
          "Qué está haciendo la aplicación: mercados que descarga, presupuesto de EVE, radar y motor."
        )}
      </.help>
    </h1>
    <div class="font-mono text-xs eth-muted tabular-nums">
      EVE {Format.eve_time(@now)} <.term name={:utc} align="end" />
      <a :if={@dev_routes} href="/dev/dashboard" class="link ml-3">LiveDashboard</a>
    </div>
  </div>

  <%!-- Barra de salud global, siempre visible (RF-8.1) --%>
  <section
    id="health"
    aria-label={gettext("Salud global")}
    class="eth-chamfer grid grid-cols-2 border border-base-300 bg-base-100 md:grid-cols-4 xl:grid-cols-7 [&>div]:border-base-300 [&>div]:px-4 [&>div]:py-3 xl:[&>div:not(:last-child)]:border-r"
  >
    <div>
      <div class="eth-kicker text-[10px]"><.term name={:tranquility} align="start" /></div>
      <%= cond do %>
        <% is_nil(@server) -> %>
          <div class="text-sm eth-muted">{gettext("Consultando…")}</div>
        <% @server[:replay] -> %>
          <div class="text-sm font-semibold text-info">{gettext("Modo Replay")}</div>
          <div class="text-xs eth-faint">{gettext("datos grabados, sin ESI")}</div>
        <% @server.online -> %>
          <div class="flex items-center gap-1.5 text-sm font-semibold text-success">
            <span class="size-1.5 bg-success"></span> {gettext("En línea")}
          </div>
          <div class="font-mono text-xs eth-muted">
            {Format.integer(@server.players)} {gettext("pilotos")}
            <span :if={@server.vip} class="text-warning">· <.term name={:vip} /></span>
          </div>
        <% true -> %>
          <div class="text-sm font-semibold text-error">{gettext("Sin respuesta")}</div>
      <% end %>
    </div>

    <div>
      <div class="eth-kicker flex items-center gap-1.5 text-[10px]">
        {gettext("Error limit")}
        <.help topic={:esi_limits} title={gettext("Error limit")}>
          {gettext(
            "EVE permite 100 errores por minuto; si se acerca a cero, la aplicación pausa ESI sola."
          )}
        </.help>
      </div>
      <div class="font-mono text-sm eth-strong">
        {if @budget.error_limit, do: "#{@budget.error_limit.remain}/100", else: "—"}
      </div>
      <div class="text-xs eth-faint">{gettext("errores permitidos por minuto")}</div>
    </div>

    <div>
      <div class="eth-kicker text-[10px]"><.term name={:esi} /></div>
      <%= if @budget.paused_until do %>
        <div class="text-sm font-semibold text-warning">{gettext("En pausa")}</div>
        <div class="text-xs eth-faint">{gettext("motivo")}: {@budget.pause_reason}</div>
        <button phx-click="resume_esi" class="btn btn-primary btn-xs mt-1">
          {gettext("Reanudar")}
        </button>
      <% else %>
        <div class="flex items-center gap-1.5 text-sm font-semibold text-success">
          <span class="size-1.5 bg-success"></span> {gettext("Activo")}
        </div>
        <button
          phx-click="pause_esi"
          data-confirm={gettext("¿Pausar todas las descargas de ESI?")}
          class="btn btn-outline btn-warning btn-xs mt-1"
        >
          {gettext("Pausa global")}
        </button>
      <% end %>
    </div>

    <div>
      <div class="eth-kicker text-[10px]">{gettext("Memoria")}</div>
      <div class="font-mono text-sm eth-strong">{Format.bytes(@memory.total)}</div>
      <div class="font-mono text-xs eth-faint">
        <.term name={:ets} /> {Format.bytes(@memory.ets)} · {Format.compact(
          totals(@regions).orders
        )} {gettext("órdenes")}
      </div>
    </div>

    <div id="sde-status">
      <div class="eth-kicker text-[10px]">{gettext("Datos estáticos")}</div>
      <% {sde_text, sde_class} = sde_label(@sde) %>
      <div class={["text-sm font-semibold", sde_class]}>{sde_text}</div>
      <div :if={@sde[:build]} class="font-mono text-xs eth-faint">
        <.term name={:sde} /> {@sde.build}
        <span :if={@sde[:routable_systems]}>
          · {Format.integer(@sde.routable_systems)} {gettext("sistemas")}
        </span>
      </div>
      <div :if={@sde[:error]} class="text-xs text-error">{@sde.error}</div>
    </div>

    <%!-- Cola de historial (RF-1.12) --%>
    <div id="history-status">
      <div class="eth-kicker text-[10px]">{gettext("Historial")}</div>
      <%= if @history do %>
        <div class="font-mono text-sm eth-strong">
          {@history.last_minute}/{@history.max_per_min} {gettext("por min")}
        </div>
        <div class="font-mono text-xs eth-faint">
          {gettext("%{cached} en caché · %{pending} en cola",
            cached: Format.integer(@history.cached),
            pending: Format.integer(@history.pending)
          )}
        </div>
      <% else %>
        <div class="text-sm eth-muted">—</div>
      <% end %>
    </div>

    <div>
      <div class="eth-kicker text-[10px]">
        {gettext("Próximo")}
        <.term name={:downtime} align="end">{gettext("downtime")}</.term>
      </div>
      <div class="font-mono text-sm eth-strong">{Format.countdown(@next_downtime, @now)}</div>
      <div class="font-mono text-xs eth-faint">11:00 UTC</div>
    </div>
  </section>

  <.tabs
    id="control-tabs"
    active={@tab}
    label={gettext("Secciones del Centro de control")}
    tabs={control_tabs(assigns)}
  />

  <%= case @tab do %>
    <% "overview" -> %>
      <%!-- Requiere atención (RF-8.10) --%>
      <% issues = attention(assigns) %>
      <div
        id="attention"
        class={
          [
            # Siempre una línea: si no entra, se corta en vez de crecer hacia abajo.
            "flex min-w-0 items-center gap-x-4 overflow-hidden whitespace-nowrap border px-4 py-2 text-sm",
            if(issues == [],
              do: "border-success/40 bg-success/5",
              else: "border-warning/50 bg-warning/10"
            )
          ]
        }
      >
        <%= if issues == [] do %>
          <span class="font-semibold text-success">{gettext("Todo en orden")}</span>
          <span class="eth-muted">
            {gettext("Ningún proceso requiere atención ahora.")}
          </span>
        <% else %>
          <span class="eth-kicker shrink-0 text-[11px] text-warning">
            {gettext("Requiere atención")}
          </span>
          <span class="flex min-w-0 items-center gap-x-4 truncate">
            <.link
              :for={{_kind, text, path} <- issues}
              patch={path}
              class="link link-hover eth-strong"
            >
              {text}
            </.link>
          </span>
        <% end %>
      </div>

      <%!-- Pipeline en vivo (RF-8.4): de EVE a las pestañas abiertas; la flecha late si pasan datos --%>
      <.panel id="pipeline" title={gettext("Pipeline")} help={:pipeline}>
        <:help_body>
          {gettext(
            "Cómo viajan los datos: la app le pide el mercado a EVE, lo guarda en memoria, el motor busca trades y los muestra en cada pestaña abierta de la app. Cada flecha se anima mientras pasan datos por ella."
          )}
        </:help_body>
        <ol class="flex flex-col items-stretch gap-2 md:flex-row md:items-center">
          <%= for {stage, i} <- Enum.with_index(pipeline_stages(assigns)) do %>
            <li
              :if={i > 0}
              aria-hidden="true"
              class="flex justify-center md:w-10 md:shrink-0"
            >
              <svg viewBox="0 0 40 12" class="h-3 w-10 max-md:rotate-90">
                <line
                  x1="0"
                  y1="6"
                  x2="32"
                  y2="6"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class={[
                    "eth-flow",
                    if(stage.flowing,
                      do: "text-primary eth-flow-on",
                      else: "text-base-content/25"
                    )
                  ]}
                />
                <path
                  d="M32 2 L39 6 L32 10 Z"
                  fill="currentColor"
                  class={if(stage.flowing, do: "text-primary", else: "text-base-content/25")}
                />
              </svg>
            </li>
            <li
              id={"pipe-#{stage.id}"}
              class="eth-chamfer-sm min-w-0 flex-1 border border-base-300 bg-base-200 px-3 py-2"
            >
              <div class="eth-kicker truncate text-[10px]">{stage.title}</div>
              <div class="truncate whitespace-nowrap font-mono text-sm eth-strong">
                {stage.value}
              </div>
              <div class="truncate text-[11px] eth-faint">{stage.detail}</div>
            </li>
          <% end %>
        </ol>
      </.panel>

      <%!-- Métricas de la última hora (RF-8.9): lo primero para ver si algo empeora --%>
      <.panel id="last-hour" title={gettext("Última hora")} help={:last_hour}>
        <:help_body>
          {gettext(
            "Un punto por minuto de los últimos 60: consultas a EVE, errores, cuánto tardan, el motor y los tokens de mercado (la parte que queda del presupuesto de consultas de mercado que da EVE cada 15 minutos). Los contadores muestran el último minuto completo. Al reiniciar la aplicación la hora empieza vacía."
          )}
        </:help_body>
        <div class="grid grid-cols-2 gap-x-6 gap-y-4 md:grid-cols-3 xl:grid-cols-6">
          <div :for={m <- metric_tiles(@metrics)} id={"metric-#{m.id}"} class="min-w-0">
            <div class="eth-kicker truncate text-[10px]" title={m.title}>{m.title}</div>
            <div class="truncate whitespace-nowrap font-mono text-sm eth-strong">{m.value}</div>
            <.spark
              id={"spark-#{m.id}"}
              values={m.values}
              label={m.title}
              class={m.class}
              hold={m.hold}
            />
          </div>
        </div>
      </.panel>

      <%!-- Pollers de los hubs como anillos dobles (§9.10) --%>
      <.panel id="pollers" title={gettext("Pollers de mercado")} help={:pollers}>
        <:help_body>
          {gettext(
            "Anillo exterior: tiempo hasta que EVE publique datos nuevos. Interior: páginas descargadas del ciclo."
          )}
        </:help_body>
        <:actions>
          <.link patch={~p"/control/market"} class="text-xs link link-primary">
            {gettext("Mapa de regiones →")}
          </.link>
        </:actions>

        <p :if={@regions == %{}} class="text-sm eth-muted">
          {gettext(
            "Todavía no hay pollers corriendo. El mercado arranca unos segundos después del servidor."
          )}
        </p>
        <div
          :if={@regions != %{}}
          class="flex flex-wrap items-start justify-center gap-6 sm:justify-start"
        >
          <.link
            :for={{r, {_key, label, color}} <- tiles(@regions, :hub, @now)}
            id={"poller-#{r.region_id}"}
            patch={~p"/control/market?region=#{r.region_id}"}
            class="group flex w-32 flex-col items-center gap-2 text-center"
            title={"#{r.name}: #{label}"}
          >
            <.double_ring
              outer={expires_fraction(r, @now)}
              inner={pages_fraction(r)}
              size={112}
              outer_class={tone_text(color)}
              inner_class="text-success"
              label={"#{r.name}: #{label} · #{timing(r, @now)}"}
            >
              <span class="font-mono text-sm eth-strong">{timing(r, @now)}</span>
              <span class={["text-[10px] uppercase tracking-wider", tone_text(color)]}>
                {label}
              </span>
            </.double_ring>
            <span class="font-display text-sm font-semibold eth-strong group-hover:text-primary">
              {r.name}
            </span>
            <span class="font-mono text-xs eth-faint">
              {Format.compact(r.orders)} {gettext("órdenes")}
            </span>
          </.link>
        </div>
        <p :if={@regions != %{}} class="mt-4 text-xs eth-faint">
          {gettext(
            "N2 · Activas (%{active}) · N3 · Resto (%{rest}) · %{fresh} regiones con datos frescos",
            active: length(regions_in_tier(@regions, :active)),
            rest: length(regions_in_tier(@regions, :rest)),
            fresh: totals(@regions).fresh
          )}
        </p>
      </.panel>

      <div class="grid gap-5 lg:grid-cols-2">
        <%!-- Motor: barra segmentada por etapa --%>
        <.panel
          id="engine"
          title={
            if(@engine_meta,
              do: gettext("Evaluación del motor · v%{v}", v: @engine_meta.version),
              else: gettext("Evaluación del motor")
            )
          }
          help={:engine}
        >
          <:help_body>
            {gettext("Cuánto tardó cada etapa de la última evaluación del mercado.")}
          </:help_body>
          <%= if @engine_meta do %>
            <div class="flex h-3 w-full gap-px bg-base-300" aria-hidden="true">
              <span
                :for={{_label, ms, class} <- engine_stages(@engine_meta)}
                class={["h-full", class]}
                style={"width: #{stage_width(ms, @engine_meta)}%"}
              ></span>
            </div>
            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs">
              <li
                :for={{label, ms, class} <- engine_stages(@engine_meta)}
                class="flex items-center gap-1.5"
              >
                <span class={["size-2", class]}></span>
                <span class="eth-muted">{label}</span>
                <span class="font-mono eth-strong">{ms} ms</span>
              </li>
              <li class="ml-auto font-mono eth-muted">
                {gettext("total %{ms} ms", ms: @engine_meta.duration_ms)} · {Format.ago(
                  @engine_meta.evaluated_at,
                  @now
                )}
              </li>
            </ul>
          <% else %>
            <p class="text-sm eth-muted">
              {gettext("El motor todavía no evaluó el mercado.")}
            </p>
          <% end %>
        </.panel>

        <%!-- Presupuestos de ESI como arcos --%>
        <.panel id="budgets" title={gettext("Presupuestos de ESI")} help={:budgets}>
          <:help_body>
            {gettext(
              "Cuánto se usó de cada presupuesto de EVE en su ventana. Cerca del límite, la aplicación baja el ritmo."
            )}
          </:help_body>
          <:actions>
            <.link patch={~p"/control/esi"} class="text-xs link link-primary">
              {gettext("Detalle →")}
            </.link>
          </:actions>
          <div class="flex flex-wrap items-end justify-around gap-4">
            <.arc
              value={error_used(@budget)}
              width={120}
              class={used_class(error_used(@budget))}
              label={gettext("Error limit usado")}
            >
              <span class="font-mono text-sm eth-strong">
                {if @budget.error_limit, do: @budget.error_limit.remain, else: "—"}
              </span>
              <span class="text-[10px] uppercase tracking-wider eth-faint">
                {gettext("error limit")}
              </span>
            </.arc>
            <.arc
              :for={g <- Enum.take(budget_groups(@budget), 3)}
              value={g.used}
              width={120}
              class={used_class(g.used)}
              label={"#{g.name}: #{round(g.used * 100)} %"}
            >
              <span class="font-mono text-sm eth-strong">{round(g.used * 100)} %</span>
              <span class="max-w-24 truncate text-[10px] uppercase tracking-wider eth-faint">
                {g.name}
              </span>
            </.arc>
          </div>
        </.panel>

        <%!-- Cola de historial como medidor de caudal --%>
        <.panel id="history-queue" title={gettext("Cola de historial")} help={:history_queue}>
          <:help_body>
            {gettext(
              "Consultas de historial por minuto frente al tope, y cuánto falta para vaciar la cola."
            )}
          </:help_body>
          <%= if @history do %>
            <div class="flex items-center gap-5">
              <.arc
                value={@history.last_minute / max(@history.max_per_min, 1)}
                width={140}
                class="text-info"
                label={gettext("Consultas de historial por minuto")}
              >
                <span class="font-mono text-base eth-strong">{@history.last_minute}</span>
                <span class="text-[10px] uppercase tracking-wider eth-faint">
                  {gettext("req/min")}
                </span>
              </.arc>
              <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm">
                <dt class="eth-muted">{gettext("Tope")}</dt>
                <dd class="font-mono">{@history.max_per_min}/min</dd>
                <dt class="eth-muted">{gettext("Pendientes")}</dt>
                <dd class="font-mono">{Format.integer(@history.pending)}</dd>
                <dt class="eth-muted">{gettext("En caché")}</dt>
                <dd class="font-mono">{Format.integer(@history.cached)}</dd>
                <dt class="eth-muted">{gettext("Para vaciar")}</dt>
                <dd class="font-mono">~{drain_minutes(@history)} min</dd>
              </dl>
            </div>
          <% else %>
            <p class="text-sm eth-muted">{gettext("La cola de historial no está corriendo.")}</p>
          <% end %>
        </.panel>

        <%!-- Radar como pulso y SDE como pasos --%>
        <.panel id="radar-pulse" title={gettext("Radar · R2Z2")} help={:radar_feed}>
          <:help_body>
            {gettext(
              "El pulso late mientras llegan kills; si el feed se corta, el radar usa solo la línea base."
            )}
          </:help_body>
          <div class="flex items-center gap-4">
            <.pulse live={not @radar_degraded} size={56} />
            <div class="min-w-0">
              <div class={[
                "text-sm font-semibold",
                if(@radar_degraded, do: "text-warning", else: "text-success")
              ]}>
                {feed_label(@feed)}
              </div>
              <div class="font-mono text-xs eth-faint">
                <span :if={@feed[:lag_s]}>{gettext("atraso %{s} s", s: @feed.lag_s)} · </span>
                {gettext("%{n} sistemas en alerta", n: Enum.count(@hot, & &1.alert))}
              </div>
              <.link patch={~p"/control/radar"} class="text-xs link link-primary">
                {gettext("Ver el radar →")}
              </.link>
            </div>
          </div>

          <div id="sde-steps" class="mt-5 border-t border-base-300 pt-3">
            <div class="eth-kicker mb-2 text-[10px]">
              {if @sde[:build], do: gettext("SDE · build %{b}", b: @sde.build), else: "SDE"}
            </div>
            <.steps steps={sde_steps(@sde)} />
          </div>
        </.panel>
      </div>
    <% "market" -> %>
      <%!-- Mapa de regiones (RF-8.2); el detalle se despliega bajo su nivel (RF-8.3) --%>
      <.panel
        id="regions"
        title={gettext("Regiones (%{n})", n: totals(@regions).count)}
        help={:pollers}
        phx-window-keydown="close_detail"
        phx-key="Escape"
      >
        <:help_body>
          {gettext(
            "Cada región con su estado, la cuenta regresiva hasta datos nuevos y las páginas. Tocá una para ver su detalle."
          )}
        </:help_body>
        <:actions>
          <span class="text-xs eth-muted">
            {gettext("%{fresh} con datos frescos", fresh: totals(@regions).fresh)}
          </span>
          <%!-- Mosaicos o mapa (RF-8.2): la vista queda en la URL --%>
          <div class="join" role="group" aria-label={gettext("Vista de las regiones")}>
            <.link
              :for={
                {view, label, icon} <- [
                  {"tiles", gettext("Mosaicos"), "hero-squares-2x2"},
                  {"map", gettext("Mapa"), "hero-map"}
                ]
              }
              id={"market-view-#{view}"}
              patch={market_view_path(view)}
              aria-current={@market_view == view && "page"}
              class={[
                "btn join-item btn-xs",
                if(@market_view == view, do: "btn-primary", else: "btn-ghost border-base-300")
              ]}
            >
              <.icon name={icon} class="size-3.5" /> {label}
            </.link>
          </div>
        </:actions>

        <%= if @market_view == "map" do %>
          <%!-- Mapa del universo (RF-8.2): pollers y calor del radar por región --%>
          <div id="market-map">
            <%= cond do %>
              <% is_nil(@galaxy) -> %>
                <.spinner
                  label={gettext("Cargando los datos estáticos…")}
                  hint={gettext("El mapa usa la posición de las regiones del SDE.")}
                />
              <% @galaxy.nodes == [] -> %>
                <p class="text-sm eth-muted">
                  {gettext(
                    "Los datos estáticos procesados no traen posiciones todavía: se vuelven a procesar al reiniciar la aplicación."
                  )}
                </p>
              <% true -> %>
                <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                  <div class="join" role="group" aria-label={gettext("Capas del mapa")}>
                    <button
                      :for={
                        {layer, label} <- [
                          {:pollers, gettext("Pollers")},
                          {:radar, gettext("Radar")},
                          {:both, gettext("Ambos")}
                        ]
                      }
                      id={"map-layer-#{layer}"}
                      type="button"
                      phx-click="map_layer"
                      phx-value-layer={layer}
                      aria-pressed={to_string(@map_layer == layer)}
                      class={[
                        "btn join-item btn-xs",
                        if(@map_layer == layer, do: "btn-primary", else: "btn-ghost border-base-300")
                      ]}
                    >
                      {label}
                    </button>
                  </div>
                  <%!-- Leyenda: el color nunca va solo (RNF-5.2) --%>
                  <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] eth-muted">
                    <li
                      :for={
                        {class, label} <- [
                          {"bg-success", gettext("fresco")},
                          {"bg-info", gettext("descargando")},
                          {"bg-warning", gettext("degradado")},
                          {"bg-error", gettext("error")},
                          {"bg-base-content/30", gettext("sin poller")}
                        ]
                      }
                      class="flex items-center gap-1"
                    >
                      <span class={["inline-block size-2 rounded-full", class]}></span>
                      {label}
                    </li>
                    <li class="flex items-center gap-1">
                      <span class="inline-block size-2.5 rounded-full bg-error/30"></span>
                      {gettext("halo: calor del radar")}
                    </li>
                  </ul>
                </div>

                <div class="eth-chamfer border border-base-300 bg-base-200/40 p-2">
                  <.galaxy_map
                    map={@galaxy}
                    regions={@regions}
                    heat={@heat}
                    layer={@map_layer}
                    selected={@selected}
                    now={@now}
                  />
                </div>
                <p class="mt-2 text-xs eth-faint">
                  {gettext(
                    "Vista desde arriba, como el mapa del juego. El anillo es la cuenta regresiva del poller y el tamaño, sus órdenes. Tocá una región para ver sus sistemas y su detalle."
                  )}
                </p>

                <%!-- Región elegida: sus sistemas y el detalle del poller (RF-8.3) --%>
                <div :if={@selected && @region_map} id="map-region-panel" class="mt-4">
                  <% name = map_region_name(@galaxy, @selected) %>
                  <h3 class="eth-kicker mb-2 flex items-center gap-2 text-[11px] text-primary">
                    {gettext("Sistemas de %{name}", name: name)}
                    <.help topic={:region_map} title={gettext("Sistemas de la región")}>
                      {gettext(
                        "Cada sistema con el color de su seguridad y los stargates internos. Con la capa Radar, los que tienen kills en la ventana llevan un halo rojo (late si están en alerta)."
                      )}
                    </.help>
                  </h3>
                  <div class="eth-chamfer border border-base-300 bg-base-200/40 p-2">
                    <.region_systems_map
                      map={@region_map}
                      heat={@system_heat}
                      layer={@map_layer}
                    />
                  </div>
                  <div :if={@regions[@selected]} class="mt-2 border border-base-300">
                    <.region_detail r={@regions[@selected]} now={@now} />
                  </div>
                </div>
            <% end %>
          </div>
        <% else %>
          <p :if={@regions == %{}} class="text-sm eth-muted">
            {gettext(
              "Todavía no hay pollers corriendo. El mercado arranca unos segundos después del servidor."
            )}
          </p>

          <div
            :for={{tier, tier_title} <- @tiers}
            :if={regions_in_tier(@regions, tier) != []}
            class="mb-5 last:mb-0"
          >
            <h3 class="eth-kicker mb-2 text-[11px]">{tier_title}</h3>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5">
              <button
                :for={{r, {_key, label, color}} <- tiles(@regions, tier, @now)}
                id={"region-#{r.region_id}"}
                type="button"
                phx-click="select_region"
                phx-value-id={r.region_id}
                aria-label={"#{r.name}: #{label}"}
                aria-expanded={to_string(@selected == r.region_id)}
                class={[
                  "flex items-center gap-3 border border-l-4 border-base-300 bg-base-200 p-2.5 text-left transition-colors hover:border-primary/60 phx-click-loading:opacity-70",
                  tone_border(color),
                  @selected == r.region_id && "border-primary bg-primary/10"
                ]}
              >
                <.ring
                  value={
                    if(r.status == :fetching,
                      do: pages_fraction(r),
                      else: expires_fraction(r, @now)
                    )
                  }
                  size={36}
                  stroke={3}
                  class={tone_text(color)}
                />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-semibold eth-strong">{r.name}</span>
                  <span class={["block text-xs", tone_text(color)]}>
                    {label} · <span class="font-mono">{timing(r, @now)}</span>
                  </span>
                  <span class="block font-mono text-[11px] eth-faint">
                    {Format.compact(r.orders)} {gettext("órd.")} · {Format.ago(
                      r.last_modified,
                      @now
                    )}
                  </span>
                </span>
                <.icon
                  name="hero-chevron-down"
                  class={[
                    "size-4 shrink-0 eth-muted transition-transform duration-200",
                    @selected == r.region_id && "rotate-180 text-primary"
                  ]}
                />
              </button>
            </div>

            <%!-- Detalle de la región elegida, a todo el ancho (RF-8.3) --%>
            <div
              :for={r <- [@regions[@selected]]}
              :if={@selected && @regions[@selected] && @regions[@selected].tier == tier}
              class="mt-2 border border-base-300"
            >
              <.region_detail r={r} now={@now} />
            </div>
          </div>
        <% end %>
      </.panel>
    <% "radar" -> %>
      <%!-- Radar de amenazas (RF-8.5, RF-3.8) --%>
      <% alerts = Enum.filter(@hot, & &1.alert) %>
      <section
        id="radar"
        aria-label={gettext("Radar de amenazas")}
        class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"
      >
        <div class={[
          "eth-chamfer flex items-center gap-3 border bg-base-100 p-3",
          if(@radar_degraded, do: "border-warning/60", else: "border-base-300")
        ]}>
          <.pulse live={not @radar_degraded} size={44} />
          <div id="radar-feed" class="min-w-0">
            <div class="eth-kicker text-[10px]">{gettext("Feed")}</div>
            <div class={[
              "truncate text-sm font-semibold",
              if(@radar_degraded, do: "text-warning", else: "eth-strong")
            ]}>
              {feed_label(@feed)}
            </div>
            <div class="font-mono text-[11px] eth-faint">
              <span :if={@feed[:lag_s]}>{gettext("atraso %{s} s", s: @feed.lag_s)}</span>
              <span :if={@feed[:processed]}>
                · {gettext("%{n} leídas", n: Format.integer(@feed.processed))}
              </span>
            </div>
          </div>
        </div>
        <div class={[
          "eth-chamfer border bg-base-100 p-3",
          if(alerts != [], do: "border-error/50", else: "border-base-300")
        ]}>
          <div class="eth-kicker text-[10px]">{gettext("Sistemas en alerta")}</div>
          <div class={[
            "font-mono text-2xl",
            if(alerts != [], do: "text-error", else: "eth-strong")
          ]}>
            {length(alerts)}
          </div>
          <div class="text-[11px] eth-faint">
            {gettext("de %{n} con kills PvP en 15 min", n: length(@hot))}
          </div>
        </div>
        <div class="eth-chamfer border border-base-300 bg-base-100 p-3">
          <div class="eth-kicker text-[10px]">{gettext("Kills en la ventana")}</div>
          <div class="font-mono text-2xl eth-strong">{Enum.sum_by(@hot, & &1.kills)}</div>
          <div class="text-[11px] eth-faint">
            {gettext("%{n} relevantes recientes", n: length(@kills))}
          </div>
        </div>
        <div class="eth-chamfer flex items-center gap-3 border border-base-300 bg-base-100 p-3">
          <.ring
            value={min(@baseline.kill_hours / (7 * 24), 1.0)}
            size={44}
            stroke={4}
            class="text-info"
            label={gettext("Cobertura de la línea base")}
          >
            <span class="font-mono text-[10px] eth-strong">{@baseline.kill_hours}h</span>
          </.ring>
          <div class="min-w-0 flex-1">
            <div class="eth-kicker flex items-center gap-1 text-[10px]">
              {gettext("Línea base")}
              <.help topic={:radar} title={gettext("Línea base")} align="end">
                {gettext(
                  "Kills y saltos por hora de cada sistema según ESI: así cada uno se compara con su propio normal. Con 7 días de muestras usa la franja horaria exacta."
                )}
              </.help>
            </div>
            <div class="text-[11px] eth-muted">
              {gettext("%{kills} h de kills · %{jumps} h de saltos",
                kills: @baseline.kill_hours,
                jumps: @baseline.jump_hours
              )}
            </div>
            <.seal
              :if={@radar_degraded}
              kind={:risk}
              label={gettext("degradado: solo línea base")}
            />
          </div>
        </div>
      </section>

      <div class="grid gap-5 xl:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
        <.panel id="radar-hot" title={gettext("Sistemas calientes")} help={:radar}>
          <:help_body>
            {gettext(
              "Kills PvP de los últimos 15 minutos frente a lo esperado (λ) según la línea base de cada sistema. Se alerta cuando es improbable que sea casualidad."
            )}
          </:help_body>
          <p :if={@hot == []} class="text-sm eth-muted">
            {gettext("Sin kills PvP en la ventana de 15 minutos.")}
          </p>
          <ul :if={@hot != []} class="-mx-4 -my-4 divide-y divide-base-300/70">
            <li
              :for={h <- @hot}
              id={"hot-#{h.system_id}"}
              class={[
                "flex flex-wrap items-center gap-x-3 gap-y-1 border-l-4 px-4 py-2.5 sm:flex-nowrap",
                if(h.alert, do: "border-l-error bg-error/5", else: "border-l-transparent")
              ]}
            >
              <.ring
                value={if(h.alert, do: h.threat, else: 0.0)}
                size={40}
                class={if(h.alert, do: "text-error", else: "text-base-content/30")}
                label={gettext("Amenaza %{p} %", p: round(h.threat * 100))}
              >
                <span class="font-mono text-[10px] eth-strong">
                  {if h.alert, do: round(h.threat * 100), else: "—"}
                </span>
              </.ring>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                  <span style={sec_style(h.system_id)} class="font-mono text-sm">
                    {sec_label(h.system_id)}
                  </span>
                  <span class="font-semibold eth-strong">{system_name(h.system_id)}</span>
                  <.seal
                    :if={h.alert && h.classification}
                    kind={:risk}
                    label={threat_type_label(h.classification.type)}
                  />
                </div>
                <div class="truncate text-xs eth-muted">
                  <%= if h.alert && h.classification do %>
                    {h.classification.description}
                  <% else %>
                    {gettext("dentro de lo habitual")}
                  <% end %>
                </div>
              </div>
              <%!-- En pantallas chicas va debajo, alineado con el nombre (anillo de 40 px + gap) --%>
              <div class="w-full pl-[52px] sm:w-36 sm:shrink-0 sm:pl-0 sm:text-right">
                <div class="flex items-center gap-2 font-mono text-sm eth-strong sm:justify-end">
                  <%!-- Tendencia (RF-8.5): kills por tramo de la ventana, del más viejo al más reciente. --%>
                  <svg
                    :if={h[:buckets]}
                    id={"hot-#{h.system_id}-series"}
                    viewBox="0 0 24 12"
                    class={["h-3 w-6", trend_class(h[:trend])]}
                    role="img"
                    aria-label={trend_label(h[:trend])}
                  >
                    <title>{trend_label(h[:trend])}</title>
                    <rect
                      :for={{n, i} <- Enum.with_index(h.buckets)}
                      x={i * 5}
                      y={12 - bar_height(n, h.buckets)}
                      width="4"
                      height={bar_height(n, h.buckets)}
                      fill="currentColor"
                    />
                  </svg>
                  <span
                    :if={h[:trend] in [:rising, :falling]}
                    id={"hot-#{h.system_id}-trend"}
                    class={trend_class(h.trend)}
                    title={trend_label(h.trend)}
                  >
                    {if h.trend == :rising, do: "▲", else: "▼"}
                  </span>
                  <span>{h.kills} <span class="text-xs eth-faint">kills</span></span>
                </div>
                <div class="font-mono text-[11px] eth-faint">
                  λ {:erlang.float_to_binary(h.lambda / 1, decimals: 2)} · ×{over_normal(h)}
                </div>
              </div>
            </li>
          </ul>
        </.panel>

        <.panel id="radar-kills-panel" title={gettext("Últimas kills relevantes")}>
          <:help_body>
            {gettext("Transportes destruidos, kills en gates y sistemas en alerta.")}
          </:help_body>
          <p :if={@kills == []} class="text-sm eth-muted">
            {gettext("Transportes destruidos, kills en gates y sistemas en alerta aparecen acá.")}
          </p>
          <ol
            id="radar-kills"
            class="-mx-4 -my-4 max-h-[34rem] divide-y divide-base-300/70 overflow-y-auto"
          >
            <li
              :for={k <- Enum.sort_by(@kills, & &1.time, {:desc, DateTime})}
              id={"kill-#{k.id}"}
              class={[
                "flex items-center gap-3 border-l-4 px-4 py-2",
                if(k.alert, do: "border-l-error", else: "border-l-transparent")
              ]}
            >
              <img
                :if={k[:victim_type_id]}
                src={"https://images.evetech.net/types/#{k.victim_type_id}/icon?size=32"}
                alt=""
                width="28"
                height="28"
                loading="lazy"
                class="bg-base-300"
              />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-1.5">
                  <span class="wrap-anywhere font-semibold eth-strong">{k.system_name}</span>
                  <span :if={k.gate_to} class="text-xs eth-muted">
                    · {gettext("gate a %{to}", to: k.gate_to)}
                  </span>
                  <.seal :if={k.victim_transport} kind={:risk} label={gettext("transporte")} />
                </div>
                <div class="font-mono text-[11px] eth-faint">
                  {k.attackers} {gettext("atacantes")}
                </div>
              </div>
              <div class="shrink-0 text-right">
                <div class="font-mono text-sm text-accent">{Format.compact(k.value)}</div>
                <div class="font-mono text-[11px] eth-faint">
                  {Calendar.strftime(k.time, "%H:%M")}
                </div>
              </div>
            </li>
          </ol>
        </.panel>
      </div>
    <% "characters" -> %>
      <%!-- Sesiones de personajes (RF-8.6) --%>
      <.panel id="character-sessions" title={gettext("Personajes")} help={:privacy}>
        <:help_body>
          {gettext(
            "Cada anillo se llena desde la última lectura hasta la próxima consulta a EVE."
          )}
        </:help_body>
        <p :if={@sessions == []} class="text-sm eth-muted">
          {gettext("No hay sesiones de personajes: iniciá sesión con EVE para vincular uno.")}
        </p>
        <div
          :for={s <- @sessions}
          id={"session-#{s.id}"}
          class="border-b border-base-300 py-4 first:pt-0 last:border-0 last:pb-0"
        >
          <div class="flex flex-wrap items-center gap-3">
            <img
              src={"https://images.evetech.net/characters/#{s.id}/portrait?size=64"}
              alt=""
              width="36"
              height="36"
              class="eth-chamfer-xs bg-base-300"
            />
            <span class="font-display font-semibold eth-strong">{s.name}</span>
            <.seal kind={session_kind(s.status)} label={session_label(s.status)} />
            <span class="text-xs eth-muted">{mode_label(s.mode)}</span>
            <span :if={s.token_expires_at} class="font-mono text-xs eth-faint">
              · {gettext("token vence en %{time}",
                time: Format.countdown(s.token_expires_at, @now)
              )}
            </span>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4 xl:grid-cols-7">
            <div
              :for={resource <- session_resources()}
              id={"session-#{s.id}-#{resource}"}
              class="flex items-center gap-2.5"
            >
              <.ring
                value={resource_fraction(s, resource, @now)}
                size={34}
                stroke={3}
                class={if(s.next_at[resource], do: "text-primary", else: "text-base-content/30")}
                label={resource_label(resource)}
              />
              <div class="min-w-0 text-xs">
                <div class="truncate eth-strong">{resource_label(resource)}</div>
                <div class="font-mono eth-faint">{Format.ago(s.read_at[resource], @now)}</div>
                <div class="font-mono eth-faint">
                  <%= if s.next_at[resource] do %>
                    {gettext("en %{time}", time: Format.countdown(s.next_at[resource], @now))}
                  <% else %>
                    {gettext("en pausa")}
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </.panel>
    <% "logs" -> %>
      <.panel id="events-panel" title={gettext("Eventos")}>
        <:actions>
          <div class="join" role="group" aria-label={gettext("Filtrar eventos")}>
            <button
              :for={
                {value, label} <- [
                  {"", gettext("Todos")},
                  {"error", gettext("Errores")},
                  {"warning", gettext("Avisos")},
                  {"action", gettext("Acciones")}
                ]
              }
              phx-click="filter_events"
              phx-value-level={value}
              aria-pressed={to_string((@event_level || "") == value)}
              class={[
                "btn join-item btn-xs",
                if((@event_level || "") == value, do: "btn-primary", else: "btn-ghost")
              ]}
            >
              {label}
            </button>
          </div>
        </:actions>

        <ol
          id="events"
          class="max-h-[32rem] divide-y divide-base-300/60 overflow-y-auto text-sm sm:space-y-1 sm:divide-y-0"
        >
          <li :if={@events == []} class="eth-muted">{gettext("Sin eventos.")}</li>
          <li
            :for={e <- @events}
            class="flex flex-col gap-1 py-2 sm:flex-row sm:items-baseline sm:gap-3 sm:py-0"
          >
            <%!-- En pantallas grandes la cabecera se disuelve (contents) y queda en una fila --%>
            <div class="flex min-w-0 items-center gap-2 sm:contents">
              <span class="shrink-0 font-mono text-xs eth-faint">{Format.eve_time(e.at)}</span>
              <span class={[
                "inline-flex w-16 shrink-0 justify-center border px-1 font-display text-[10px] font-semibold tracking-wider",
                level_badge(e.level) |> elem(1)
              ]}>
                {level_badge(e.level) |> elem(0)}
              </span>
              <span class="min-w-0 truncate text-xs eth-muted sm:w-28 sm:shrink-0">
                {e.source}
              </span>
            </div>
            <span class="min-w-0 flex-1 wrap-anywhere">{e.message}</span>
          </li>
        </ol>
      </.panel>
    <% "esi" -> %>
      <.panel id="esi-budgets" title={gettext("Presupuestos por grupo")} help={:budgets}>
        <:help_body>
          {gettext(
            "ESI limita las consultas por grupo de endpoints y ventana de tiempo; cada personaje tiene los suyos."
          )}
        </:help_body>
        <div class="flex flex-wrap items-end gap-6">
          <.arc
            value={error_used(@budget)}
            width={150}
            class={used_class(error_used(@budget))}
            label={gettext("Error limit usado")}
          >
            <span class="font-mono text-base eth-strong">
              {if @budget.error_limit, do: "#{@budget.error_limit.remain}/100", else: "—"}
            </span>
            <span class="text-[10px] uppercase tracking-wider eth-faint">
              {gettext("error limit")}
            </span>
          </.arc>
          <p class="max-w-md text-sm eth-muted">
            {gettext(
              "Si el error limit baja de %{n}, ESI se pausa sola hasta que se reinicie la ventana. La pausa global de arriba detiene todo a mano.",
              n: Eth.GameRules.get(:error_limit_pause_at)
            )}
          </p>
        </div>

        <p :if={budget_groups(@budget) == []} class="mt-4 text-sm eth-muted">
          {gettext("Todavía no hubo respuestas de ESI con presupuesto.")}
        </p>
        <table :if={budget_groups(@budget) != []} class="table table-sm mt-4">
          <thead>
            <tr class="border-base-300">
              <th class="eth-kicker text-[10px]">{gettext("Grupo")}</th>
              <th class="eth-kicker text-[10px]">{gettext("Personaje")}</th>
              <th class="eth-kicker text-[10px]">{gettext("Uso")}</th>
              <th class="eth-kicker text-right text-[10px]">{gettext("Restan")}</th>
              <th class="eth-kicker text-right text-[10px]">{gettext("Actualizado")}</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={g <- budget_groups(@budget)} class="border-base-300/60">
              <td class="font-mono text-xs">{g.name}</td>
              <td class="text-xs eth-muted">{g.character_id || gettext("público")}</td>
              <td class="w-48">
                <div class="h-1.5 w-full bg-base-300">
                  <div
                    class={[
                      "h-full",
                      g.used >= 0.9 && "bg-error",
                      (g.used >= 0.7 and g.used < 0.9) && "bg-warning",
                      g.used < 0.7 && "bg-primary"
                    ]}
                    style={"width: #{round(g.used * 100)}%"}
                  >
                  </div>
                </div>
              </td>
              <td class="text-right font-mono text-xs">
                {g.remaining && Format.integer(g.remaining)}/{g.limit && Format.integer(g.limit)}
              </td>
              <td class="text-right font-mono text-xs eth-faint">{Format.ago(g.at, @now)}</td>
            </tr>
          </tbody>
        </table>
      </.panel>
  <% end %>
</Layouts.app>
