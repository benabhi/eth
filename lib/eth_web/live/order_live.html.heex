<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:hunter}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-bold">{gettext("Cazador de trades")}</h1>
      <.family_nav active={:orders} search={@form[:search].value} />
    </div>
    <p id="orders-status" class="text-sm text-base-content/70 tabular-nums">
      <%= if @meta do %>
        {gettext("%{total} oportunidades por órdenes", total: Format.integer(@total))} · {gettext(
          "evaluado %{ago}",
          ago: Format.ago(@meta.evaluated_at, @now)
        )}
      <% else %>
        {gettext("El motor todavía no evaluó el mercado: espera el primer ciclo de descarga.")}
      <% end %>
    </p>
  </div>

  <%!-- Filtros (RF-6.4) --%>
  <.form
    for={@form}
    id="orders-filters"
    phx-change="filter"
    phx-submit="filter"
    class="card border border-base-300 p-4"
  >
    <div class="grid grid-cols-2 gap-x-3 md:grid-cols-4 xl:grid-cols-8">
      <div class="col-span-2">
        <.input
          field={@form[:search]}
          label={gettext("Buscar")}
          placeholder={gettext("Objeto, estación o sistema")}
          phx-debounce="300"
        />
      </div>
      <.input
        field={@form[:mode]}
        type="select"
        label={gettext("Modo")}
        options={[
          {gettext("Todos"), ""},
          {gettext("Listado"), "listing"},
          {gettext("Compra por orden"), "buy_order"}
        ]}
      />
      <.input
        field={@form[:route_mode]}
        type="select"
        label={gettext("Ruta")}
        options={[{gettext("Segura (solo highsec)"), "secure"}, {gettext("Rápida"), "shortest"}]}
      />
      <.input
        field={@form[:max_days]}
        type="number"
        min="1"
        label={gettext("Días máx. de espera")}
        phx-debounce="400"
      />
      <.input
        field={@form[:min_margin]}
        type="number"
        min="0"
        step="0.5"
        label={gettext("Margen ≥ (%)")}
        phx-debounce="400"
      />
      <.input
        field={@form[:min_profit]}
        label={gettext("Beneficio ≥")}
        placeholder="1M"
        phx-debounce="400"
      />
      <.input
        field={@form[:capital]}
        label={gettext("Capital")}
        placeholder={gettext("sin límite")}
        phx-debounce="400"
      />
    </div>
    <div class="grid grid-cols-2 gap-x-3 md:grid-cols-4 xl:grid-cols-8">
      <.input
        field={@form[:cargo_m3]}
        type="number"
        min="0"
        label={gettext("Bodega (m³)")}
        placeholder={gettext("sin límite")}
        phx-debounce="400"
      />
      <.input
        field={@form[:accounting]}
        type="select"
        label={gettext("Accounting")}
        options={for level <- 0..5, do: {"#{level}", "#{level}"}}
      />
      <.input
        field={@form[:broker_relations]}
        type="select"
        label={gettext("Broker Relations")}
        options={for level <- 0..5, do: {"#{level}", "#{level}"}}
      />
      <div class="col-span-2">
        <.input
          field={@form[:sort]}
          type="select"
          label={gettext("Ordenar por")}
          options={[
            {gettext("Beneficio × Certeza por día de espera"), "score"},
            {gettext("Beneficio"), "profit"},
            {gettext("Margen"), "margin"},
            {gettext("Menos espera"), "days"},
            {gettext("Menos saltos"), "jumps"}
          ]}
        />
      </div>
      <div class="col-span-2">
        <.input
          field={@form[:shield]}
          type="select"
          label={gettext("Anti-scam")}
          options={[
            {gettext("Ocultar SCAM"), "hide_scam"},
            {gettext("Ocultar SCAM y sospechosas"), "safe"},
            {gettext("Mostrar todo"), "all"}
          ]}
        />
      </div>
      <div class="flex items-end pb-2">
        <button type="button" phx-click="reset_filters" class="btn btn-ghost btn-sm">
          {gettext("Restablecer")}
        </button>
      </div>
    </div>
    <p id="orders-hint" class="mt-1 text-xs text-base-content/60">
      {gettext(
        "Publicás una orden propia en un hub y esperás a que se ejecute. El beneficio y la espera son estimaciones según el volumen de 7 días y la competencia."
      )}
    </p>
  </.form>

  <div class="grid gap-6 2xl:grid-cols-[1fr_28rem]">
    <section aria-labelledby="orders-title" class="card border border-base-300">
      <div class="border-b border-base-300 p-3">
        <h2 id="orders-title" class="font-semibold">
          {gettext("Oportunidades por órdenes")}
          <span class="text-sm font-normal text-base-content/60">
            · {gettext("máx. 200 filas")}
          </span>
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>{gettext("Objeto y modo")}</th>
              <th>{gettext("Origen → Destino")}</th>
              <th class="text-right">{gettext("Precio sugerido")}</th>
              <th class="text-right">{gettext("Beneficio")}</th>
              <th class="text-right">{gettext("Espera")}</th>
              <th class="text-right">{gettext("Saltos")}</th>
              <th class="text-right">{gettext("Certeza")}</th>
            </tr>
          </thead>
          <tbody id="order-rows" phx-update="stream">
            <tr id="orders-empty" class="hidden only:table-row">
              <td colspan="7" class="py-8 text-center text-base-content/60">
                {gettext(
                  "Sin oportunidades con estos filtros. El historial de los hubs se descarga de a poco: puede tardar unos minutos en aparecer."
                )}
              </td>
            </tr>
            <tr
              :for={{dom_id, row} <- @streams.rows}
              id={dom_id}
              phx-click="select"
              phx-value-id={row.id}
              class={[
                "cursor-pointer align-top hover:bg-base-200",
                @selected == row.id && "bg-base-200"
              ]}
            >
              <td class="max-w-64">
                <div class="flex items-center gap-2">
                  <img
                    src={"https://images.evetech.net/types/#{row.opportunity.type_id}/icon?size=32"}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                  />
                  <span class="truncate font-semibold">{row.opportunity.type_name}</span>
                </div>
                <div class="flex flex-wrap gap-1">
                  <span class="badge badge-secondary badge-xs">{mode_label(row.mode)}</span>
                  <span
                    :if={row.shield.status != :ok}
                    class={["badge badge-xs", shield_class(row.shield.status)]}
                    title={Enum.join(row.shield.reasons, " · ")}
                  >
                    {shield_label(row.shield.status)}
                  </span>
                </div>
              </td>
              <td class="max-w-80 text-sm">
                <div class="truncate" title={row.opportunity.origin.name}>
                  <span style={sec_style(row.opportunity.origin.security)} class="font-mono">
                    {sec_label(row.opportunity.origin.security)}
                  </span>
                  {row.opportunity.origin.name}
                </div>
                <div class="truncate" title={row.opportunity.destination.name}>
                  →
                  <span style={sec_style(row.opportunity.destination.security)} class="font-mono">
                    {sec_label(row.opportunity.destination.security)}
                  </span>
                  {row.opportunity.destination.name}
                </div>
              </td>
              <td class="text-right tabular-nums">
                <div>{Format.compact(row.price)}</div>
                <div class="text-xs text-base-content/60">
                  ×{Format.integer(row.quantity)}
                </div>
              </td>
              <td class="text-right tabular-nums">
                <div class="font-semibold">{Format.compact(row.profit)}</div>
                <div class="text-xs text-base-content/60">
                  {gettext("inv.")} {Format.compact(row.cost)} · {pct(row.margin_pct)}
                </div>
              </td>
              <td class="text-right tabular-nums">{days_label(row.days)}</td>
              <td class="text-right tabular-nums">{row.jumps_to_origin}+{row.jumps}</td>
              <td class="text-right">
                <span class={["badge badge-sm", certainty_class(row.certainty)]}>
                  {pct(row.certainty)}
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Detalle (RF-6.5, RF-6.12) --%>
    <aside
      id="orders-detail"
      aria-labelledby="orders-detail-title"
      class="card h-fit border border-base-300 p-4"
    >
      <%= if r = @selected_row do %>
        <h2 id="orders-detail-title" class="text-lg font-semibold">
          {r.opportunity.type_name}
        </h2>
        <p class="text-sm">
          <span class="badge badge-secondary badge-sm">{mode_label(r.mode)}</span>
          {r.opportunity.origin.name}<br />→ {r.opportunity.destination.name}
        </p>

        <div
          :if={r.shield.status != :ok}
          id="orders-shield-alert"
          class={[
            "alert mt-3 py-2 text-sm",
            if(r.shield.status == :scam, do: "alert-error", else: "alert-warning")
          ]}
        >
          <span>{shield_label(r.shield.status)} · {Enum.join(r.shield.reasons, " · ")}</span>
        </div>

        <h3 class="mt-3 text-sm font-semibold">{gettext("Cómo se hace")}</h3>
        <ol class="ml-4 list-decimal text-sm">
          <%= if r.mode == :listing do %>
            <li>
              {gettext("Comprá %{qty} unidades en el origen (a sus órdenes de venta).",
                qty: Format.integer(r.quantity)
              )}
            </li>
            <li>{gettext("Llevalas al hub (%{jumps} saltos).", jumps: r.jumps)}</li>
            <li>
              {gettext("Publicá una orden de venta al precio sugerido y esperá a que se venda.")}
            </li>
          <% else %>
            <li>
              {gettext(
                "Publicá en el hub una orden de compra por %{qty} unidades al precio sugerido.",
                qty: Format.integer(r.quantity)
              )}
            </li>
            <li>
              {gettext("Cuando se llene, llevá la carga al destino (%{jumps} saltos).",
                jumps: r.jumps
              )}
            </li>
            <li>{gettext("Vendé a las órdenes de compra del destino.")}</li>
          <% end %>
        </ol>

        <h3 class="mt-3 text-sm font-semibold">{price_label(r.mode)}</h3>
        <div class="rounded border border-base-300 p-2">
          <div class="font-mono text-lg">{price_text(r.price)}</div>
          <button
            id="copy-order-price"
            type="button"
            phx-hook=".CopyText"
            data-text={price_text(r.price)}
            class="btn btn-ghost btn-xs"
          >
            <.icon name="hero-clipboard-document" class="size-4" /> {gettext("Copiar precio")}
          </button>
          <p class="text-xs text-base-content/60">
            {gettext("Supera a la mejor orden del hub (%{best}); %{n} órdenes compiten cerca.",
              best: Format.compact(r.best_competitor),
              n: r.competition
            )}
          </p>
        </div>

        <h3 class="mt-3 text-sm font-semibold">{gettext("Cálculo")}</h3>
        <dl class="grid grid-cols-[auto_1fr] gap-x-3 text-sm tabular-nums">
          <dt class="text-base-content/60">{gettext("Cantidad")}</dt>
          <dd>{Format.integer(r.quantity)} ({Format.integer(round(r.cargo_m3))} m³)</dd>
          <dt class="text-base-content/60">{gettext("Inversión")}</dt>
          <dd>{Format.compact(r.cost)}</dd>
          <dt class="text-base-content/60">{gettext("Ingreso neto")}</dt>
          <dd>{Format.compact(r.revenue)}</dd>
          <dt class="text-base-content/60">{gettext("Beneficio")}</dt>
          <dd class="font-semibold">{Format.compact(r.profit)} ({pct(r.margin_pct)})</dd>
          <dt class="text-base-content/60">{gettext("Broker fee (hub)")}</dt>
          <dd>{pct2(r.broker_rate)}</dd>
          <dt class="text-base-content/60">{gettext("Sales tax")}</dt>
          <dd>{pct2(r.tax_rate)}</dd>
          <dt class="text-base-content/60">{gettext("Espera estimada")}</dt>
          <dd>
            {days_label(r.days)} · {gettext("volumen del hub %{v}/día",
              v: Format.integer(round(r.daily_volume))
            )}
          </dd>
          <dt class="text-base-content/60">{gettext("Viaje")}</dt>
          <dd>
            {r.jumps_to_origin}+{r.jumps} {gettext("saltos")} · ETA {Format.travel(r.seconds)}
          </dd>
        </dl>

        <h3 class="mt-3 text-sm font-semibold">
          {gettext("¿Por qué Certeza %{c}?", c: pct(r.certainty))}
        </h3>
        <ul class="text-xs text-base-content/80 tabular-nums">
          <li>{gettext("Competencia en el hub")}: {pct(r.breakdown.competition_certainty)}</li>
          <li>{gettext("Frescura de datos")}: {pct(r.breakdown.data_certainty)}</li>
          <li>{gettext("Anti-scam")}: {pct(r.breakdown.scam_certainty)}</li>
        </ul>

        <button
          id="orders-open-market"
          type="button"
          phx-click="open_market"
          disabled={is_nil(@pilot)}
          class="btn btn-sm mt-4"
        >
          <.icon name="hero-building-storefront" class="size-4" /> {gettext("Abrir mercado")}
        </button>
        <p class="mt-1 text-xs text-base-content/60">
          {gettext(
            "ESI no permite publicar órdenes: la aplicación sugiere el precio y la orden la publicás vos en el juego."
          )}
        </p>
      <% else %>
        <h2 id="orders-detail-title" class="text-lg font-semibold">{gettext("Detalle")}</h2>
        <p class="text-sm text-base-content/70">
          {gettext(
            "Elegí una oportunidad para ver los pasos, el precio sugerido, las comisiones y la espera estimada."
          )}
        </p>
      <% end %>
    </aside>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyText">
    export default {
      mounted() {
        this.el.addEventListener("click", (event) => {
          event.stopPropagation()
          navigator.clipboard.writeText(this.el.dataset.text).then(() => this.pushEvent("copied", {}))
        })
      }
    }
  </script>
</Layouts.app>
