<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:hunter}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <.board_header
    title={gettext("Tablón de caza")}
    family={:orders}
    search={@form[:search].value}
    status_id="orders-status"
  >
    <:stats :if={@meta}>
      <.stat
        id="orders-open"
        label={gettext("oportunidades")}
        value={Format.integer(@total)}
        class="items-end"
      />
      <.stat
        id="orders-reward"
        label={gettext("recompensa en el tablón")}
        value={Format.compact(@reward)}
        value_class="text-accent"
        class="items-end"
      />
    </:stats>
    <:status>
      <%= if @meta do %>
        {gettext("%{total} oportunidades por órdenes", total: Format.integer(@total))} · {gettext(
          "evaluado %{ago}",
          ago: Format.ago(@meta.evaluated_at, @now)
        )}
      <% else %>
        {gettext("El motor todavía no evaluó el mercado: espera el primer ciclo de descarga.")}
      <% end %>
    </:status>
  </.board_header>

  <%!-- Filtros (RF-6.4) --%>
  <.form
    for={@form}
    id="orders-filters"
    phx-change="filter"
    phx-submit="filter"
    class="eth-chamfer border border-base-300 bg-base-100 px-4 pt-3 pb-2"
  >
    <div class="grid grid-cols-2 gap-x-3 md:grid-cols-4 xl:grid-cols-8">
      <div class="col-span-2">
        <.input
          field={@form[:search]}
          label={gettext("Buscar")}
          placeholder={gettext("Objeto, estación o sistema")}
          phx-debounce="300"
        />
      </div>
      <.input
        field={@form[:mode]}
        type="select"
        label={gettext("Modo")}
        options={[
          {gettext("Todos"), ""},
          {gettext("Listado"), "listing"},
          {gettext("Compra por orden"), "buy_order"}
        ]}
      />
      <.input
        field={@form[:route_mode]}
        type="select"
        label={gettext("Ruta")}
        options={[{gettext("Segura (solo highsec)"), "secure"}, {gettext("Rápida"), "shortest"}]}
      />
      <.input
        field={@form[:max_days]}
        type="number"
        min="1"
        label={gettext("Días máx. de espera")}
        phx-debounce="400"
      />
      <.input
        field={@form[:min_margin]}
        type="number"
        min="0"
        step="0.5"
        label={gettext("Margen ≥ (%)")}
        phx-debounce="400"
      />
      <.input
        field={@form[:min_profit]}
        label={gettext("Beneficio ≥")}
        placeholder="1M"
        phx-debounce="400"
      />
      <.input
        field={@form[:capital]}
        label={gettext("Capital")}
        placeholder={gettext("sin límite")}
        phx-debounce="400"
      />
    </div>
    <div class="grid grid-cols-2 gap-x-3 md:grid-cols-4 xl:grid-cols-8">
      <.input
        field={@form[:cargo_m3]}
        type="number"
        min="0"
        label={gettext("Bodega (m³)")}
        placeholder={gettext("sin límite")}
        phx-debounce="400"
      />
      <.input
        field={@form[:accounting]}
        type="select"
        label={gettext("Accounting")}
        options={for level <- 0..5, do: {"#{level}", "#{level}"}}
      />
      <.input
        field={@form[:broker_relations]}
        type="select"
        label={gettext("Broker Relations")}
        options={for level <- 0..5, do: {"#{level}", "#{level}"}}
      />
      <div class="col-span-2">
        <.input
          field={@form[:sort]}
          type="select"
          label={gettext("Ordenar por")}
          options={[
            {gettext("Beneficio × Certeza por día de espera"), "score"},
            {gettext("Beneficio"), "profit"},
            {gettext("Margen"), "margin"},
            {gettext("Menos espera"), "days"},
            {gettext("Menos saltos"), "jumps"}
          ]}
        />
      </div>
      <div class="col-span-2">
        <.input
          field={@form[:shield]}
          type="select"
          label={gettext("Anti-scam")}
          options={[
            {gettext("Ocultar SCAM"), "hide_scam"},
            {gettext("Ocultar SCAM y sospechosas"), "safe"},
            {gettext("Mostrar todo"), "all"}
          ]}
        />
      </div>
      <div class="flex items-end pb-2">
        <button type="button" phx-click="reset_filters" class="btn btn-ghost btn-sm">
          {gettext("Restablecer")}
        </button>
      </div>
    </div>
    <p id="orders-hint" class="mb-2 text-xs eth-faint">
      {gettext(
        "Publicás una orden propia en un hub y esperás a que se ejecute. El beneficio y la espera son estimaciones según el volumen de 7 días y la competencia."
      )}
    </p>
  </.form>

  <div class="grid gap-5 2xl:grid-cols-[minmax(0,1fr)_28rem]">
    <section aria-labelledby="orders-title" class="border border-base-300 bg-base-100">
      <div class="border-b border-base-300 px-4 py-2.5">
        <h2 id="orders-title" class="eth-kicker flex items-center gap-2">
          {gettext("Oportunidades por órdenes")}
          <span class="font-sans text-xs normal-case tracking-normal eth-faint">
            · {gettext("máx. 200 filas")}
          </span>
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr class="border-base-300">
              <th class="eth-kicker text-[11px]">
                <span class="flex items-center gap-1.5">
                  {gettext("Objeto y modo")}
                  <.help topic={:listing} title={gettext("Modos")} align="start">
                    {gettext(
                      "Listado: comprás en el origen y publicás una venta en el hub. Compra por orden: publicás una compra en el hub y vendés en el destino."
                    )}
                  </.help>
                </span>
              </th>
              <th class="eth-kicker text-[11px]">{gettext("Origen → Destino")}</th>
              <th class="eth-kicker text-right text-[11px]">{gettext("Precio sugerido")}</th>
              <th class="eth-kicker text-right text-[11px]">{gettext("Recompensa")}</th>
              <th class="eth-kicker text-right text-[11px]">
                <span class="flex items-center justify-end gap-1.5">
                  {gettext("Espera")}
                  <.help topic={:wait} title={gettext("Espera")} align="end">
                    {gettext(
                      "Días estimados hasta que la orden se ejecute, según el volumen de 7 días y la competencia."
                    )}
                  </.help>
                </span>
              </th>
              <th class="eth-kicker hidden text-right text-[11px] md:table-cell">
                {gettext("Saltos")}
              </th>
              <th class="eth-kicker text-right text-[11px]">{gettext("Certeza")}</th>
            </tr>
          </thead>
          <tbody id="order-rows" phx-update="stream">
            <tr id="orders-empty" class="hidden only:table-row">
              <td colspan="7" class="py-10 text-center eth-muted">
                {gettext(
                  "Sin oportunidades con estos filtros. El historial de los hubs se descarga de a poco: puede tardar unos minutos en aparecer."
                )}
              </td>
            </tr>
            <tr
              :for={{dom_id, row} <- @streams.rows}
              id={dom_id}
              phx-click="select"
              phx-value-id={row.id}
              class={[
                "eth-enter cursor-pointer border-base-300/60 align-middle transition-colors hover:bg-primary/5",
                @selected == row.id && "bg-primary/10"
              ]}
            >
              <td class="max-w-64">
                <div class="flex items-center gap-2">
                  <img
                    src={"https://images.evetech.net/types/#{row.opportunity.type_id}/icon?size=32"}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                    class="bg-base-300"
                  />
                  <span class="truncate font-semibold eth-strong">
                    {row.opportunity.type_name}
                  </span>
                </div>
                <div class="mt-0.5 flex flex-wrap gap-1">
                  <.seal kind={:order} label={mode_label(row.mode)} />
                  <.shield_seal shield={row.shield} />
                </div>
              </td>
              <td class="max-w-80 text-sm">
                <div class="truncate" title={row.opportunity.origin.name}>
                  <span style={sec_style(row.opportunity.origin.security)} class="font-mono">
                    {sec_label(row.opportunity.origin.security)}
                  </span>
                  {row.opportunity.origin.name}
                </div>
                <div class="truncate" title={row.opportunity.destination.name}>
                  →
                  <span style={sec_style(row.opportunity.destination.security)} class="font-mono">
                    {sec_label(row.opportunity.destination.security)}
                  </span>
                  {row.opportunity.destination.name}
                </div>
              </td>
              <td class="text-right">
                <div class="font-mono text-sm">{Format.compact(row.price)}</div>
                <div class="font-mono text-xs eth-faint">×{Format.integer(row.quantity)}</div>
              </td>
              <td class="text-right">
                <div class="font-mono text-base font-medium text-accent">
                  {Format.compact(row.profit)}
                </div>
                <div class="font-mono text-xs eth-faint">
                  {gettext("inv.")} {Format.compact(row.cost)} · {pct(row.margin_pct)}
                </div>
              </td>
              <td class="text-right font-mono text-sm">{days_label(row.days)}</td>
              <td class="hidden text-right font-mono text-sm md:table-cell">
                {row.jumps_to_origin}+{row.jumps}
              </td>
              <td>
                <div class="flex justify-end"><.certainty_ring value={row.certainty} /></div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Ficha (RF-6.5, RF-6.12) --%>
    <aside
      id="orders-detail"
      aria-labelledby="orders-detail-title"
      class="eth-chamfer h-fit border border-base-300 bg-base-100 p-4 2xl:sticky 2xl:top-20"
    >
      <%= if @selected_row do %>
        <div :for={r <- [@selected_row]} id="orders-detail-body">
          <div class="flex items-start gap-3">
            <img
              src={"https://images.evetech.net/types/#{r.opportunity.type_id}/icon?size=64"}
              alt=""
              width="48"
              height="48"
              class="bg-base-300"
            />
            <div class="min-w-0">
              <h2 id="orders-detail-title" class="font-display text-lg font-semibold eth-strong">
                {r.opportunity.type_name}
              </h2>
              <p class="text-sm eth-muted">
                {r.opportunity.origin.name}<br />→ {r.opportunity.destination.name}
              </p>
              <div class="mt-1"><.seal kind={:order} label={mode_label(r.mode)} /></div>
            </div>
          </div>

          <div
            :if={r.shield.status != :ok}
            id="orders-shield-alert"
            role={if r.shield.status == :scam, do: "alert", else: "status"}
            class={[
              "mt-3 border px-3 py-2 text-sm",
              if(r.shield.status == :scam,
                do: "border-error/50 bg-error/10 text-error",
                else: "border-warning/50 bg-warning/10 text-warning"
              )
            ]}
          >
            <span class="font-semibold">{shield_label(r.shield.status)}</span>
            <span class="eth-muted">· {Enum.join(r.shield.reasons, " · ")}</span>
          </div>

          <.detail_heading topic={:listing}>{gettext("Cómo se hace")}</.detail_heading>
          <ol class="space-y-1.5 text-sm">
            <li :for={{step, i} <- Enum.with_index(how_to(r), 1)} class="flex gap-2.5">
              <span class="eth-chamfer-xs flex size-5 shrink-0 items-center justify-center border border-primary/60 font-display text-[11px] text-primary">
                {i}
              </span>
              <span>{step}</span>
            </li>
          </ol>

          <.detail_heading topic={:station}>{price_label(r.mode)}</.detail_heading>
          <div class="eth-chamfer-sm border border-base-300 bg-base-200 p-2.5">
            <div class="font-mono text-lg eth-strong">{price_text(r.price)}</div>
            <button
              id="copy-order-price"
              type="button"
              phx-hook=".CopyText"
              data-text={price_text(r.price)}
              class="btn btn-ghost btn-xs -ml-2"
            >
              <.icon name="hero-clipboard-document" class="size-4" /> {gettext("Copiar precio")}
            </button>
            <p class="text-xs eth-faint">
              {gettext("Supera a la mejor orden del hub (%{best}); %{n} órdenes compiten cerca.",
                best: Format.compact(r.best_competitor),
                n: r.competition
              )}
            </p>
          </div>

          <.detail_heading topic={:broker}>{gettext("Cálculo")}</.detail_heading>
          <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm tabular-nums">
            <dt class="eth-muted">{gettext("Cantidad")}</dt>
            <dd class="font-mono">
              {Format.integer(r.quantity)} ({Format.integer(round(r.cargo_m3))} m³)
            </dd>
            <dt class="eth-muted">{gettext("Inversión")}</dt>
            <dd class="font-mono">{Format.compact(r.cost)}</dd>
            <dt class="eth-muted">{gettext("Ingreso neto")}</dt>
            <dd class="font-mono">{Format.compact(r.revenue)}</dd>
            <dt class="eth-muted">{gettext("Beneficio")}</dt>
            <dd class="font-mono font-semibold text-accent">
              {Format.compact(r.profit)} ({pct(r.margin_pct)})
            </dd>
            <dt class="eth-muted">{gettext("Broker fee (hub)")}</dt>
            <dd class="font-mono">{pct2(r.broker_rate)}</dd>
            <dt class="eth-muted">{gettext("Sales tax")}</dt>
            <dd class="font-mono">{pct2(r.tax_rate)}</dd>
            <dt class="eth-muted">{gettext("Espera estimada")}</dt>
            <dd class="font-mono">
              {days_label(r.days)} · {gettext("volumen del hub %{v}/día",
                v: Format.integer(round(r.daily_volume))
              )}
            </dd>
            <dt class="eth-muted">{gettext("Viaje")}</dt>
            <dd class="font-mono">
              {r.jumps_to_origin}+{r.jumps} {gettext("saltos")} · ETA {Format.travel(r.seconds)}
            </dd>
          </dl>

          <.detail_heading topic={:competition}>
            {gettext("¿Por qué Certeza %{c}?", c: pct(r.certainty))}
          </.detail_heading>
          <ul class="space-y-0.5 text-xs tabular-nums">
            <li class="flex justify-between gap-3">
              <span class="eth-muted">{gettext("Competencia en el hub")}</span>
              <span class="font-mono">{pct(r.breakdown.competition_certainty)}</span>
            </li>
            <li class="flex justify-between gap-3">
              <span class="eth-muted">{gettext("Frescura de datos")}</span>
              <span class="font-mono">{pct(r.breakdown.data_certainty)}</span>
            </li>
            <li class="flex justify-between gap-3">
              <span class="eth-muted">{gettext("Anti-scam")}</span>
              <span class="font-mono">{pct(r.breakdown.scam_certainty)}</span>
            </li>
          </ul>

          <button
            id="orders-open-market"
            type="button"
            phx-click="open_market"
            disabled={is_nil(@pilot)}
            class="eth-chamfer-sm btn btn-accent mt-5 w-full font-display tracking-wide"
          >
            <.icon name="hero-building-storefront" class="size-4" /> {gettext("Abrir mercado")}
          </button>
          <p class="mt-2 text-xs eth-faint">
            {gettext(
              "ESI no permite publicar órdenes: la aplicación sugiere el precio y la orden la publicás vos en el juego."
            )}
          </p>
        </div>
      <% else %>
        <.detail_placeholder
          id="orders-detail-title"
          topic={:listing}
          link={gettext("Cómo funciona el trading por órdenes")}
        >
          {gettext(
            "Elegí una oportunidad para ver los pasos, el precio sugerido, las comisiones y la espera estimada."
          )}
        </.detail_placeholder>
      <% end %>
    </aside>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyText">
    export default {
      mounted() {
        this.el.addEventListener("click", (event) => {
          event.stopPropagation()
          navigator.clipboard.writeText(this.el.dataset.text).then(() => this.pushEvent("copied", {}))
        })
      }
    }
  </script>
</Layouts.app>
