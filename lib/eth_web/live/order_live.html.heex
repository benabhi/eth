<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:hunter}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <.board_header
    title={gettext("Tablón de caza")}
    family={:orders}
    search={@form[:search].value}
    status_id="orders-status"
  >
    <:stats :if={@meta}>
      <.stat
        id="orders-open"
        label={gettext("oportunidades")}
        value={Format.integer(@total)}
        class="items-end"
      />
      <.stat
        id="orders-reward"
        label={gettext("recompensa en el tablón")}
        value={Format.compact(@reward)}
        value_class="text-accent"
        class="items-end"
      />
    </:stats>
    <:status>
      <%= if @meta do %>
        {gettext("%{total} oportunidades por órdenes", total: Format.integer(@total))} · {gettext(
          "evaluado %{ago}",
          ago: Format.ago(@meta.evaluated_at, @now)
        )}
      <% else %>
        {gettext("El motor todavía no evaluó el mercado: espera el primer ciclo de descarga.")}
      <% end %>
    </:status>
  </.board_header>

  <section
    id="orders-board"
    aria-labelledby="orders-title"
    class="eth-chamfer border border-base-300 bg-base-100"
    phx-window-keydown="close_detail"
    phx-key="Escape"
  >
    <%!-- Barra de filtros acoplada a la tabla (RF-6.4) --%>
    <.form
      for={@form}
      id="orders-filters"
      phx-change="filter"
      phx-submit="filter"
      class="flex flex-col gap-2 border-b border-base-300 p-3"
    >
      <div class="flex flex-wrap items-center gap-2">
        <h2 id="orders-title" class="sr-only">{gettext("Oportunidades por órdenes")}</h2>
        <.filter_search
          field={@form[:search]}
          placeholder={gettext("Objeto, estación o sistema")}
          class="min-w-56 flex-1"
        />
        <.filter_field
          field={@form[:mode]}
          type="select"
          label={gettext("Modo")}
          options={[
            {gettext("Todos"), ""},
            {gettext("Listado"), "listing"},
            {gettext("Compra por orden"), "buy_order"}
          ]}
        />
        <.filter_field
          field={@form[:sort]}
          type="select"
          label={gettext("Orden")}
          options={[
            {gettext("Beneficio × Certeza por día"), "score"},
            {gettext("Beneficio"), "profit"},
            {gettext("Margen"), "margin"},
            {gettext("Menos espera"), "days"},
            {gettext("Menos saltos"), "jumps"}
          ]}
        />
        <.filter_field
          field={@form[:route_mode]}
          type="select"
          label={gettext("Ruta")}
          options={[{gettext("Segura"), "secure"}, {gettext("Rápida"), "shortest"}]}
        />
        <span :if={@pending > 0} class="border border-warning/60 px-2 py-1 text-xs text-warning">
          {ngettext("%{count} cambio pendiente", "%{count} cambios pendientes", @pending)}
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <.filter_field
          field={@form[:max_days]}
          type="number"
          min="1"
          label={gettext("Espera ≤ días")}
          phx-debounce="400"
          class="w-40"
        />
        <.filter_field
          field={@form[:min_margin]}
          type="number"
          min="0"
          step="0.5"
          label={gettext("Margen ≥ %")}
          phx-debounce="400"
          class="w-36"
        />
        <.filter_field
          field={@form[:min_profit]}
          label={gettext("Beneficio ≥")}
          placeholder="1M"
          phx-debounce="400"
          class="w-40"
        />
        <.filter_field
          field={@form[:capital]}
          label={gettext("Capital")}
          placeholder={gettext("sin límite")}
          phx-debounce="400"
          class="w-44"
        />
        <.filter_field
          field={@form[:cargo_m3]}
          type="number"
          min="0"
          label={gettext("Bodega m³")}
          placeholder={gettext("sin límite")}
          phx-debounce="400"
          class="w-44"
        />
        <.filter_field
          field={@form[:accounting]}
          type="select"
          label="Accounting"
          options={for level <- 0..5, do: {"#{level}", "#{level}"}}
        />
        <.filter_field
          field={@form[:broker_relations]}
          type="select"
          label="Broker Relations"
          options={for level <- 0..5, do: {"#{level}", "#{level}"}}
        />
        <.filter_field
          field={@form[:shield]}
          type="select"
          label={gettext("Anti-scam")}
          options={[
            {gettext("Ocultar SCAM"), "hide_scam"},
            {gettext("Ocultar SCAM y sospechosas"), "safe"},
            {gettext("Mostrar todo"), "all"}
          ]}
        />
        <button
          type="button"
          phx-click="reset_filters"
          class="btn btn-ghost btn-sm h-8 min-h-8 eth-muted"
        >
          <.icon name="hero-arrow-uturn-left" class="size-4" /> {gettext("Restablecer")}
        </button>
      </div>
    </.form>

    <%!-- Encabezado de columnas --%>
    <div class={[
      grid_class(),
      "border-b border-base-300 bg-base-200/60 py-2 eth-kicker text-[10px]"
    ]}>
      <span class="flex items-center gap-1">
        {gettext("Objeto y modo")}
        <.help topic={:listing} title={gettext("Modos")} align="start">
          {gettext(
            "Listado: comprás en el origen y publicás una venta en el hub. Compra por orden: publicás una compra en el hub y vendés en el destino."
          )}
        </.help>
      </span>
      <span class="hidden md:block">{gettext("Origen → Destino")}</span>
      <span class="hidden text-right md:block">{gettext("Precio")}</span>
      <span class="text-right">{gettext("Recompensa")}</span>
      <span class="flex items-center justify-end gap-1">
        {gettext("Espera")}
        <.help topic={:wait} title={gettext("Espera")} align="end">
          {gettext(
            "Días estimados hasta que la orden se ejecute, según el volumen de 7 días y la competencia."
          )}
        </.help>
      </span>
      <span class="hidden text-right lg:block">{gettext("Saltos")}</span>
      <span class="flex items-center justify-end gap-1">
        <span class="hidden md:inline">{gettext("Certeza")}</span>
        <.help topic={:competition} title={gettext("Certeza")} align="end">
          {gettext("Baja con la competencia en el hub, los datos viejos y el escudo.")}
        </.help>
      </span>
      <span class="hidden md:block"></span>
    </div>

    <div id="order-rows" phx-update="stream">
      <div id="orders-empty" class="hidden px-4 py-12 text-center eth-muted only:block">
        {gettext(
          "Sin oportunidades con estos filtros. El historial de los hubs se descarga de a poco: puede tardar unos minutos en aparecer."
        )}
      </div>
      <div
        :for={{dom_id, row} <- @streams.rows}
        id={dom_id}
        class={[
          "border-b border-base-300/70 last:border-b-0",
          @selected == row.id && "shadow-[inset_3px_0_0_var(--color-primary)]"
        ]}
      >
        <div
          data-head
          role="button"
          tabindex="0"
          aria-expanded={to_string(@selected == row.id)}
          phx-click="select"
          phx-value-id={row.id}
          class={[
            grid_class(),
            "cursor-pointer py-2.5 transition-colors hover:bg-primary/5",
            @selected == row.id && "bg-primary/10"
          ]}
        >
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <img
                src={"https://images.evetech.net/types/#{row.opportunity.type_id}/icon?size=32"}
                alt=""
                width="24"
                height="24"
                loading="lazy"
                class="bg-base-300"
              />
              <span class="truncate font-semibold eth-strong">{row.opportunity.type_name}</span>
            </div>
            <div class="mt-0.5 flex flex-wrap gap-1">
              <.seal kind={:order} label={mode_label(row.mode)} />
              <.shield_seal shield={row.shield} />
            </div>
          </div>
          <div class="hidden min-w-0 text-sm md:block">
            <div class="truncate" title={row.opportunity.origin.name}>
              <span style={sec_style(row.opportunity.origin.security)} class="font-mono">
                {sec_label(row.opportunity.origin.security)}
              </span>
              {row.opportunity.origin.name}
            </div>
            <div class="truncate" title={row.opportunity.destination.name}>
              →
              <span style={sec_style(row.opportunity.destination.security)} class="font-mono">
                {sec_label(row.opportunity.destination.security)}
              </span>
              {row.opportunity.destination.name}
            </div>
          </div>
          <div class="hidden text-right md:block">
            <div class="font-mono text-sm">{Format.compact(row.price)}</div>
            <div class="font-mono text-xs eth-faint">×{Format.integer(row.quantity)}</div>
          </div>
          <div class="text-right">
            <div class="font-mono text-base font-medium text-accent">
              {Format.compact(row.profit)}
            </div>
            <div class="font-mono text-xs eth-faint">
              {Format.compact(row.cost)} · {pct(row.margin_pct)}
            </div>
          </div>
          <div class="text-right font-mono text-sm">{days_label(row.days)}</div>
          <div class="hidden text-right font-mono text-sm lg:block">
            {row.jumps_to_origin}+{row.jumps}
          </div>
          <div class="flex justify-end"><.certainty_ring value={row.certainty} /></div>
          <div class="hidden justify-end md:flex">
            <.icon
              name="hero-chevron-down"
              class={[
                "size-4 eth-muted transition-transform duration-200",
                @selected == row.id && "rotate-180 text-primary"
              ]}
            />
          </div>
        </div>

        <%!-- Ficha bajo la fila (RF-6.5, RF-6.12) --%>
        <.row_detail
          :if={@selected == row.id}
          id="orders-detail"
          label={gettext("Ficha de %{name}", name: row.opportunity.type_name)}
        >
          <div
            :if={row.shield.status != :ok}
            id="orders-shield-alert"
            role={if row.shield.status == :scam, do: "alert", else: "status"}
            class={[
              "border px-3 py-2 text-sm md:col-span-2 xl:col-span-4",
              if(row.shield.status == :scam,
                do: "border-error/50 bg-error/10 text-error",
                else: "border-warning/50 bg-warning/10 text-warning"
              )
            ]}
          >
            <span class="font-semibold">{shield_label(row.shield.status)}</span>
            <span class="eth-muted">· {Enum.join(row.shield.reasons, " · ")}</span>
          </div>

          <.detail_col title={gettext("Cómo se hace")} topic={:listing}>
            <ol class="space-y-1.5 text-sm">
              <li :for={{step, i} <- Enum.with_index(how_to(row), 1)} class="flex gap-2.5">
                <span class="eth-chamfer-xs flex size-5 shrink-0 items-center justify-center border border-primary/60 font-display text-[11px] text-primary">
                  {i}
                </span>
                <span>{step}</span>
              </li>
            </ol>
          </.detail_col>

          <.detail_col title={price_label(row.mode)} topic={:station}>
            <div class="eth-chamfer-sm border border-base-300 bg-base-100 p-2.5">
              <div class="font-mono text-lg eth-strong">{price_text(row.price)}</div>
              <button
                id="copy-order-price"
                type="button"
                phx-hook=".CopyText"
                data-text={price_text(row.price)}
                class="btn btn-ghost btn-xs -ml-2"
              >
                <.icon name="hero-clipboard-document" class="size-4" /> {gettext("Copiar precio")}
              </button>
            </div>
            <p class="mt-1.5 text-xs eth-faint">
              {gettext("Supera a la mejor orden del hub (%{best}); %{n} órdenes compiten cerca.",
                best: Format.compact(row.best_competitor),
                n: row.competition
              )}
            </p>
          </.detail_col>

          <.detail_col title={gettext("Cálculo")} topic={:broker}>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm tabular-nums">
              <dt class="eth-muted">{gettext("Cantidad")}</dt>
              <dd class="text-right font-mono">
                {Format.integer(row.quantity)} ({Format.integer(round(row.cargo_m3))} m³)
              </dd>
              <dt class="eth-muted">{gettext("Inversión")}</dt>
              <dd class="text-right font-mono">{Format.compact(row.cost)}</dd>
              <dt class="eth-muted">{gettext("Ingreso neto")}</dt>
              <dd class="text-right font-mono">{Format.compact(row.revenue)}</dd>
              <dt class="eth-muted">{gettext("Broker fee · tax")}</dt>
              <dd class="text-right font-mono">
                {pct2(row.broker_rate)} · {pct2(row.tax_rate)}
              </dd>
              <dt class="eth-muted">{gettext("Espera")}</dt>
              <dd class="text-right font-mono">
                {days_label(row.days)}
                <span class="eth-faint">
                  · {Format.integer(round(row.daily_volume))}/{gettext("día")}
                </span>
              </dd>
              <dt class="eth-muted">{gettext("Viaje")}</dt>
              <dd class="text-right font-mono">
                {row.jumps_to_origin}+{row.jumps} · {Format.travel(row.seconds)}
              </dd>
              <dt class="mt-1 border-t border-base-300 pt-1 eth-muted">{gettext("Beneficio")}</dt>
              <dd class="mt-1 border-t border-base-300 pt-1 text-right font-mono font-semibold text-accent">
                {Format.compact(row.profit)} · {pct(row.margin_pct)}
              </dd>
            </dl>
          </.detail_col>

          <.detail_col
            title={gettext("¿Por qué Certeza %{c}?", c: pct(row.certainty))}
            topic={:competition}
          >
            <ul class="space-y-0.5 text-xs tabular-nums">
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Competencia en el hub")}</span>
                <span class="font-mono">{pct(row.breakdown.competition_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Frescura de datos")}</span>
                <span class="font-mono">{pct(row.breakdown.data_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Anti-scam")}</span>
                <span class="font-mono">{pct(row.breakdown.scam_certainty)}</span>
              </li>
            </ul>
          </.detail_col>

          <:footer>
            <button
              id="orders-open-market"
              type="button"
              phx-click="open_market"
              disabled={is_nil(@pilot)}
              class="eth-chamfer-sm btn btn-accent btn-sm px-5 font-display tracking-wide"
            >
              <.icon name="hero-building-storefront" class="size-4" /> {gettext("Abrir mercado")}
            </button>
            <span class="text-xs eth-faint">
              {gettext(
                "ESI no permite publicar órdenes: la aplicación sugiere el precio y la orden la publicás vos en el juego."
              )}
            </span>
            <button
              type="button"
              phx-click="close_detail"
              class="btn btn-ghost btn-sm ml-auto eth-muted"
            >
              <.icon name="hero-chevron-up" class="size-4" /> {gettext("Cerrar")}
              <kbd class="kbd kbd-xs">Esc</kbd>
            </button>
          </:footer>
        </.row_detail>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-base-300 px-4 py-2 text-xs eth-faint">
      <span id="orders-hint">
        {gettext(
          "Publicás una orden propia en un hub y esperás a que se ejecute. El beneficio y la espera son estimaciones según el volumen de 7 días y la competencia."
        )}
      </span>
      <span>
        {gettext("máx. 200 filas")} ·
        <.link href={EthWeb.Docs.href(:listing)} class="link link-primary">
          {gettext("Cómo funciona el trading por órdenes")}
        </.link>
      </span>
    </div>
  </section>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyText">
    export default {
      mounted() {
        this.el.addEventListener("click", (event) => {
          event.stopPropagation()
          navigator.clipboard.writeText(this.el.dataset.text).then(() => this.pushEvent("copied", {}))
        })
      }
    }
  </script>
</Layouts.app>
