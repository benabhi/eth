<Layouts.app
  flash={@flash}
  radar_degraded={@radar_degraded}
  active={:hunter}
  wide
  pilot={@pilot}
  characters={@characters}
  ship_form={@ship_form}
>
  <%!-- Cabecera del tablón (RF-6.13) --%>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <h1 class="font-display text-2xl font-semibold eth-strong sm:text-[26px]">
      {gettext("Tablón de caza")}
    </h1>
    <.family_nav active={:direct} search={@form[:search].value} />
    <div class="flex-1"></div>
    <div class="flex items-end gap-6">
      <.stat
        :if={@meta}
        id="board-open"
        label={gettext("contratos abiertos")}
        value={Format.integer(@total)}
        class="items-end"
      />
      <.stat
        :if={@meta}
        id="board-reward"
        label={gettext("recompensa en el tablón")}
        value={Format.compact(@reward)}
        value_class="text-accent"
        class="items-end"
      />
    </div>
  </div>
  <p id="hunter-status" class="-mt-2 text-xs eth-faint tabular-nums">
    <%= if @meta do %>
      {gettext("%{total} oportunidades", total: Format.integer(@total))} · {gettext(
        "evaluado %{ago}",
        ago: Format.ago(@meta.evaluated_at, @now)
      )} · v{@meta.version} · {gettext("motor %{ms} ms", ms: @meta.duration_ms)}
    <% else %>
      {gettext("El motor todavía no evaluó el mercado: espera el primer ciclo de descarga.")}
    <% end %>
  </p>

  <%!-- Filtros (RF-6.4) --%>
  <.form
    for={@form}
    id="filters"
    phx-change="filter"
    phx-submit="filter"
    class="eth-chamfer border border-base-300 bg-base-100 px-4 pt-3 pb-2"
  >
    <div class="grid grid-cols-2 gap-x-3 md:grid-cols-4 xl:grid-cols-9">
      <div class="col-span-2 md:col-span-4 xl:col-span-2">
        <.input
          field={@form[:search]}
          label={gettext("Buscar")}
          placeholder={gettext("Objeto, estación, sistema o región")}
          phx-debounce="300"
        />
      </div>
      <.input
        field={@form[:route_mode]}
        type="select"
        label={gettext("Ruta")}
        options={[
          {gettext("Segura (solo highsec)"), "secure"},
          {gettext("Rápida"), "shortest"},
          {gettext("Evasiva (esquiva amenazas)"), "evasive"}
        ]}
      />
      <.input field={@form[:max_jumps]} type="number" min="0" label={gettext("Saltos máx.")} />
      <.input
        field={@form[:min_profit]}
        label={gettext("Beneficio ≥")}
        placeholder="1M"
        phx-debounce="400"
      />
      <.input
        field={@form[:min_roi]}
        type="number"
        min="0"
        step="0.1"
        label={gettext("ROI ≥ (%)")}
      />
      <.input
        field={@form[:capital]}
        label={gettext("Capital")}
        placeholder={gettext("sin límite")}
        phx-debounce="400"
      />
      <.input
        field={@form[:cargo_m3]}
        type="number"
        min="0"
        label={gettext("Bodega (m³)")}
        placeholder={gettext("sin límite")}
        phx-debounce="400"
      />
      <.input
        field={@form[:accounting]}
        type="select"
        label={gettext("Accounting")}
        options={for level <- 0..5, do: {"#{level}", "#{level}"}}
      />
    </div>
    <div class="flex flex-wrap items-end gap-x-3">
      <div class="w-48">
        <.input
          field={@form[:sort]}
          type="select"
          label={gettext("Ordenar por")}
          options={[
            {"TVS", "tvs"},
            {gettext("Beneficio"), "profit"},
            {"ISK/h", "isk_per_hour"},
            {"ROI", "roi"},
            {gettext("Saltos"), "jumps"},
            {gettext("Inversión"), "cost"},
            {gettext("Frescura"), "age"}
          ]}
        />
      </div>
      <div class="w-56">
        <.input
          field={@form[:shield]}
          type="select"
          label={gettext("Anti-scam")}
          options={[
            {gettext("Ocultar SCAM"), "hide_scam"},
            {gettext("Ocultar SCAM y sospechosas"), "safe"},
            {gettext("Mostrar todo"), "all"}
          ]}
        />
      </div>
      <div class="pb-2">
        <.input field={@form[:liquid_only]} type="checkbox" label={gettext("Solo líquidos")} />
      </div>
      <button type="button" phx-click="reset_filters" class="btn btn-ghost btn-sm mb-2">
        {gettext("Restablecer")}
      </button>
      <span id="filters-hint" class="mb-3 text-xs eth-faint">
        <%= if @pilot do %>
          {gettext(
            "Accounting, capital y bodega de %{name}; distancias desde su sistema. Montos con sufijo: 5M, 1.5B.",
            name: @pilot.name
          )}
        <% else %>
          {gettext(
            "Modo invitado: impuestos, capital y bodega manuales. Montos con sufijo: 5M, 1.5B."
          )}
        <% end %>
      </span>
    </div>
  </.form>

  <div class="grid gap-5 2xl:grid-cols-[minmax(0,1fr)_28rem]">
    <section aria-labelledby="opps-title" class="border border-base-300 bg-base-100">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-base-300 px-4 py-2.5">
        <h2 id="opps-title" class="eth-kicker flex items-center gap-2">
          {gettext("Contratos")}
          <span class="normal-case tracking-normal font-sans text-xs eth-faint">
            · {route_label(@query.route_mode)} · {gettext("máx. 200 filas")}
          </span>
        </h2>
        <div class="flex items-center gap-2">
          <span :if={@frozen and @pending > 0} class="badge badge-warning badge-sm">
            {ngettext("%{count} cambio pendiente", "%{count} cambios pendientes", @pending)}
          </span>
          <button
            id="freeze"
            type="button"
            phx-click="toggle_freeze"
            aria-pressed={to_string(@frozen)}
            class={[
              "btn btn-sm",
              if(@frozen, do: "btn-warning", else: "btn-ghost border-base-300")
            ]}
          >
            {if @frozen, do: gettext("Aplicar y reanudar"), else: gettext("Congelar")}
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="table table-sm">
          <thead>
            <tr class="border-base-300">
              <th class="eth-kicker w-14 text-[11px]">
                <span class="flex items-center gap-1.5">
                  {gettext("Rango")}
                  <.help topic={:rank} title={gettext("Rango")} align="start">
                    {gettext(
                      "El TVS del contrato en una letra: S ≥ 90, A ≥ 75, B ≥ 50, C ≥ 25; el resto, D."
                    )}
                  </.help>
                </span>
              </th>
              <th class="eth-kicker text-[11px]">{gettext("Contrato")}</th>
              <th class="eth-kicker text-[11px]">{gettext("Ruta")}</th>
              <th class="eth-kicker hidden text-[11px] lg:table-cell">
                <span class="flex items-center gap-1.5">
                  {gettext("Peligro")}
                  <.help topic={:danger} title={gettext("Peligro")}>
                    {gettext(
                      "Riesgo de la ruta según el radar, tu nave y el valor de la carga (1 − Certeza de ruta)."
                    )}
                  </.help>
                </span>
              </th>
              <th class="eth-kicker text-right text-[11px]">
                <span class="flex items-center justify-end gap-1.5">
                  {gettext("Recompensa")}
                  <.help topic={:profit} title={gettext("Recompensa")} align="end">
                    {gettext(
                      "Beneficio neto: lo que cobrás al vender, menos lo que pagás al comprar y el sales tax."
                    )}
                  </.help>
                </span>
              </th>
              <th class="eth-kicker hidden text-right text-[11px] md:table-cell">
                <span class="flex items-center justify-end gap-1.5">
                  ISK/h · ETA
                  <.help topic={:isk_per_hour} title="ISK/h" align="end">
                    {gettext("Beneficio por hora contando los saltos desde tu ubicación.")}
                  </.help>
                </span>
              </th>
              <th class="eth-kicker text-right text-[11px]">
                <span class="flex items-center justify-end gap-1.5">
                  {gettext("Certeza")}
                  <.help topic={:certainty} title={gettext("Certeza")} align="end">
                    {gettext(
                      "Qué tan probable es que el contrato salga como se calculó cuando llegues."
                    )}
                  </.help>
                </span>
              </th>
              <th class="w-10"><span class="sr-only">{gettext("Acciones")}</span></th>
            </tr>
          </thead>
          <tbody id="opportunities" phx-update="stream">
            <tr id="opportunities-empty" class="hidden only:table-row">
              <td colspan="8" class="py-10 text-center eth-muted">
                {gettext(
                  "Sin oportunidades con estos filtros. Probá bajar el beneficio mínimo o el ROI."
                )}
              </td>
            </tr>
            <tr
              :for={{dom_id, row} <- @streams.rows}
              id={dom_id}
              phx-click="select"
              phx-value-id={row.id}
              class={[
                "eth-enter cursor-pointer border-base-300/60 align-middle transition-colors hover:bg-primary/5",
                @selected == row.id && "bg-primary/10"
              ]}
            >
              <td><.rank_badge tvs={row.tvs} /></td>
              <td class="max-w-64">
                <div class="flex items-center gap-2">
                  <img
                    src={"https://images.evetech.net/types/#{row.opportunity.type_id}/icon?size=32"}
                    alt=""
                    width="24"
                    height="24"
                    loading="lazy"
                    class="bg-base-300"
                  />
                  <span class="truncate font-semibold eth-strong">
                    {row.opportunity.type_name}
                  </span>
                </div>
                <div class="mt-0.5 flex flex-wrap items-center gap-1">
                  <span class="font-mono text-xs eth-faint">
                    ×{Format.integer(row.quantity)} · {Format.integer(round(row.cargo_m3))} m³
                  </span>
                  <.seal
                    :if={row.route_alerts.count > 0}
                    kind={:risk}
                    label={threat_seal(row.route_alerts)}
                    title={row.route_alerts.worst.classification.description}
                  />
                  <.seal
                    :if={row.shield.status == :scam}
                    kind={:scam}
                    title={Enum.join(row.shield.reasons, " · ")}
                  />
                  <.seal
                    :if={row.shield.status in [:suspicious, :no_history]}
                    kind={:suspicious}
                    label={shield_label(row.shield.status)}
                    title={Enum.join(row.shield.reasons, " · ")}
                  />
                  <.seal
                    :if={row.illiquid}
                    kind={:illiquid}
                    title={
                      gettext("%{days} días con operaciones en 30",
                        days: row.history.destination.days_traded_30d
                      )
                    }
                  />
                  <.seal :if={row.opportunity.remote_sale} kind={:range} />
                  <.seal
                    :if={
                      row.opportunity.origin.structure or row.opportunity.destination.structure
                    }
                    kind={:structure}
                    label={access_label(worst_access(row.access))}
                    title={access_title(row.access)}
                  />
                </div>
              </td>
              <td class="max-w-80 text-sm">
                <div class="truncate" title={row.opportunity.origin.name}>
                  <span style={sec_style(row.opportunity.origin.security)} class="font-mono">
                    {sec_label(row.opportunity.origin.security)}
                  </span>
                  {row.opportunity.origin.name}
                </div>
                <div class="truncate" title={row.opportunity.destination.name}>
                  →
                  <span style={sec_style(row.opportunity.destination.security)} class="font-mono">
                    {sec_label(row.opportunity.destination.security)}
                  </span>
                  {row.opportunity.destination.name}
                  <span class="font-mono text-xs eth-faint">
                    · {row.jumps_to_origin}+{row.jumps} {gettext("saltos")}
                  </span>
                </div>
              </td>
              <td class="hidden w-32 lg:table-cell">
                <.danger_meter level={Grade.danger(row.breakdown.route_certainty)} />
              </td>
              <td class="text-right">
                <div class="font-mono text-base font-medium text-accent">
                  {Format.compact(row.profit)}
                </div>
                <div class="font-mono text-xs eth-faint">
                  {gettext("inv.")} {Format.compact(row.cost)} · {pct(row.roi)}
                </div>
              </td>
              <td class="hidden text-right md:table-cell">
                <div class="font-mono text-sm eth-strong">{Format.compact(row.isk_per_hour)}</div>
                <div class="font-mono text-xs eth-faint">{Format.travel(row.seconds)}</div>
              </td>
              <td class="text-right">
                <div class="flex justify-end">
                  <.ring
                    value={row.certainty}
                    size={40}
                    class={certainty_color(row.certainty)}
                    label={gettext("Certeza %{c}", c: pct(row.certainty))}
                  >
                    <span class="font-mono text-[10px] eth-strong">{round(row.certainty * 100)}</span>
                  </.ring>
                </div>
              </td>
              <td>
                <span :if={scam?(row)} class="text-xs text-error">{gettext("bloqueada")}</span>
                <button
                  :if={not scam?(row)}
                  id={"copy-#{row.id}"}
                  type="button"
                  phx-hook=".Clipboard"
                  data-text={multibuy(row)}
                  class="btn btn-ghost btn-xs"
                  title={gettext("Copiar Multibuy")}
                >
                  <.icon name="hero-clipboard-document" class="size-4" />
                  <span class="sr-only">{gettext("Copiar Multibuy")}</span>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Ficha del contrato: detalle y explicabilidad (RF-6.5) --%>
    <aside
      id="detail"
      aria-labelledby="detail-title"
      class="eth-chamfer h-fit border border-base-300 bg-base-100 p-4 2xl:sticky 2xl:top-20"
    >
      <%= cond do %>
        <% @detail_loading -> %>
          <h2 id="detail-title" class="sr-only">{gettext("Ficha del contrato")}</h2>
          <div id="detail-loading" class="flex flex-col gap-4 py-2">
            <.spinner
              label={gettext("Recalculando la ficha…")}
              hint={gettext("Libro, ruta y radar para tu nave")}
            />
            <.skeleton rows={3} />
          </div>
        <% @selected_row -> %>
          <div :for={r <- [@selected_row]} id="detail-body">
            <div class="flex items-start gap-3">
              <.rank_badge tvs={r.tvs} size="lg" />
              <div class="min-w-0">
                <h2 id="detail-title" class="font-display text-lg font-semibold eth-strong">
                  {r.opportunity.type_name}
                </h2>
                <p class="text-sm eth-muted">
                  {r.opportunity.origin.name}<br />→ {r.opportunity.destination.name}
                </p>
              </div>
            </div>
            <p class="mt-1 text-xs eth-faint">
              {route_label(@query.route_mode)} · {r.jumps_to_origin} {gettext("saltos al origen")} + {r.jumps} {gettext(
                "al destino"
              )} · ETA {Format.travel(r.seconds)}
            </p>

            <div
              :if={r.shield.status != :ok}
              id="shield-alert"
              role={if scam?(r), do: "alert", else: "status"}
              class={[
                "mt-3 flex flex-col items-start gap-1 border px-3 py-2 text-sm",
                if(scam?(r),
                  do: "border-error/50 bg-error/10",
                  else: "border-warning/50 bg-warning/10"
                )
              ]}
            >
              <div class={["font-semibold", if(scam?(r), do: "text-error", else: "text-warning")]}>
                <%= if scam?(r) do %>
                  {gettext("SCAM ALERT · acciones bloqueadas")}
                <% else %>
                  {shield_label(r.shield.status)}
                <% end %>
              </div>
              <ul class="text-xs eth-muted">
                <li :for={reason <- r.shield.reasons}>{reason}</li>
              </ul>
              <button
                :if={r.shield.status in [:scam, :suspicious]}
                id="report-false-positive"
                type="button"
                phx-click="report_false_positive"
                class="btn btn-ghost btn-xs"
              >
                {gettext("Reportar falso positivo")}
              </button>
            </div>

            <h3 class="eth-kicker mt-4 mb-1.5 flex items-center gap-2 text-[11px] text-primary">
              {gettext("Cálculo")} <.help topic={:profit} title={gettext("Cálculo")} />
            </h3>
            <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-sm tabular-nums">
              <dt class="eth-muted">{gettext("Cantidad")}</dt>
              <dd class="font-mono">
                {Format.integer(r.quantity)} ({Format.integer(round(r.cargo_m3))} m³)
              </dd>
              <dt class="eth-muted">{gettext("Compra promedio")}</dt>
              <dd class="font-mono">{Format.compact(r.avg_buy)}</dd>
              <dt class="eth-muted">{gettext("Venta promedio")}</dt>
              <dd class="font-mono">{Format.compact(r.avg_sell)}</dd>
              <dt class="eth-muted">{gettext("Inversión")}</dt>
              <dd class="font-mono">{Format.compact(r.cost)}</dd>
              <dt class="eth-muted">{gettext("Sales tax")}</dt>
              <dd class="font-mono">
                <.tip title={gettext("Sales tax")} topic={:sales_tax} align="end">
                  {Format.compact(r.tax)} ({pct(r.tax_rate)})
                  <:body>{gettext("Impuesto al vender, según tu nivel de Accounting.")}</:body>
                  <:formula>
                    {Format.compact(r.revenue + r.tax)} × {pct(r.tax_rate)} = {Format.compact(
                      r.tax
                    )}
                  </:formula>
                </.tip>
              </dd>
              <dt class="eth-muted">{gettext("Ingreso neto")}</dt>
              <dd class="font-mono">{Format.compact(r.revenue)}</dd>
              <dt class="eth-muted">{gettext("Beneficio")}</dt>
              <dd class="font-mono font-semibold text-accent">
                {Format.compact(r.profit)} (ROI {pct(r.roi)})
              </dd>
              <dt class="eth-muted">ISK/h</dt>
              <dd class="font-mono">{Format.compact(r.isk_per_hour)}</dd>
            </dl>

            <h3 class="eth-kicker mt-4 mb-1.5 flex items-center gap-2 text-[11px] text-primary">
              {gettext("Libro consumido")}
              <.help topic={:walk} title={gettext("Libro consumido")} />
            </h3>
            <div class="grid grid-cols-2 gap-2 font-mono text-xs">
              <div>
                <div class="eth-faint">{gettext("Compra (ventas)")}</div>
                <div :for={{price, qty} <- r.asks_used}>
                  {Format.compact(price)} × {Format.integer(qty)}
                </div>
              </div>
              <div>
                <div class="eth-faint">{gettext("Venta (compras)")}</div>
                <div :for={{price, qty, min_volume} <- r.bids_used}>
                  {Format.compact(price)} × {Format.integer(qty)}<span :if={min_volume > 1}> (mín. {min_volume})</span>
                </div>
              </div>
            </div>

            <h3 class="eth-kicker mt-4 mb-1.5 flex items-center gap-2 text-[11px] text-primary">
              {gettext("Historial (destino, 30 días)")}
              <.help topic={:liquidity} title={gettext("Historial")} />
            </h3>
            <%= if h = r.history.destination do %>
              <div id="history" class="text-sm">
                <svg
                  :if={sparkline(h.daily_avg)}
                  viewBox="0 0 120 32"
                  preserveAspectRatio="none"
                  class="h-10 w-full text-primary"
                  role="img"
                  aria-label={gettext("Precio promedio diario de los últimos 30 días")}
                >
                  <polyline
                    points={sparkline(h.daily_avg)}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
                <dl class="grid grid-cols-[auto_1fr] gap-x-3 tabular-nums">
                  <dt class="eth-muted">{gettext("Mediana 7 d")}</dt>
                  <dd class="font-mono">{(h.median_7d && Format.compact(h.median_7d)) || "—"}</dd>
                  <dt class="eth-muted">{gettext("Mediana 30 d")}</dt>
                  <dd class="font-mono">
                    {(h.median_30d && Format.compact(h.median_30d)) || "—"}
                  </dd>
                  <dt class="eth-muted">{gettext("Volumen diario 7 d")}</dt>
                  <dd class="font-mono">{Format.integer(round(h.volume_avg_7d))}</dd>
                  <dt class="eth-muted">{gettext("Días operados")}</dt>
                  <dd class="font-mono">{h.days_traded_30d} / 30</dd>
                  <dt :if={r.history.origin} class="eth-muted">
                    {gettext("Mediana 7 d origen")}
                  </dt>
                  <dd :if={r.history.origin} class="font-mono">
                    {(r.history.origin.median_7d && Format.compact(r.history.origin.median_7d)) ||
                      "—"}
                  </dd>
                </dl>
                <p class="text-xs eth-faint">
                  {gettext(
                    "Datos hasta el %{date} (ESI publica un día por vez, después del downtime).",
                    date: Calendar.strftime(h.as_of, "%d/%m")
                  )}
                </p>
              </div>
            <% else %>
              <p id="history" class="text-xs eth-faint">
                {gettext(
                  "Todavía sin historial para este tipo en la región: se pide en orden de prioridad (máx. 250 por minuto)."
                )}
              </p>
            <% end %>

            <%!-- Ruta (RF-6.5): sistemas del camino, seguridad y amenazas del radar --%>
            <h3 class="eth-kicker mt-4 mb-1.5 flex items-center gap-2 text-[11px] text-primary">
              {gettext("Ruta (%{mode})", mode: route_label(@query.route_mode))}
              <.help topic={:radar} title={gettext("Ruta")} />
            </h3>
            <div :if={d = @route_details} id="route" class="text-xs">
              <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 font-mono">
                <span
                  :for={{s, i} <- Enum.with_index(d.to_origin ++ tl(d.route))}
                  title={"#{s.name} · #{pct(s.probability)}"}
                  class={[
                    "whitespace-nowrap",
                    s.type && "bg-error px-1 text-error-content",
                    i == length(d.to_origin) - 1 && "font-bold underline"
                  ]}
                >
                  <span style={sec_style(s.security)}>{sec_label(s.security)}</span> {s.name}
                </span>
              </div>
              <p class="mt-1 eth-faint">
                {gettext(
                  "En negrita, el origen (se compra ahí). Pasá el mouse para ver el riesgo."
                )}
              </p>
              <ul :if={Enum.any?(d.to_origin ++ d.route, & &1.type)} class="mt-1 space-y-0.5">
                <li
                  :for={
                    s <-
                      Enum.uniq_by(Enum.filter(d.to_origin ++ d.route, & &1.type), & &1.system_id)
                  }
                  class="text-error"
                >
                  {s.name}: {s.description} · {gettext("riesgo")} {pct(s.probability)}
                </li>
              </ul>
            </div>

            <h3 class="eth-kicker mt-4 mb-1.5 flex items-center gap-2 text-[11px] text-primary">
              {gettext("¿Por qué TVS %{tvs}?", tvs: r.tvs)}
              <.help topic={:tvs} title="TVS" />
            </h3>
            <p class="eth-formula">
              {gettext("utilidad")} {:erlang.float_to_binary(r.utility, decimals: 2)} × {gettext(
                "certeza"
              )} {:erlang.float_to_binary(r.certainty, decimals: 2)} = {r.tvs} → {Grade.rank(
                r.tvs
              )}
            </p>
            <ul class="mt-2 space-y-0.5 text-xs tabular-nums">
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Órdenes vigentes al llegar")}</span>
                <span class="font-mono">{pct(r.breakdown.order_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Frescura de datos")}</span>
                <span class="font-mono">{pct(r.breakdown.data_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">
                  {gettext("Anti-scam (%{status})", status: shield_label(r.shield.status))}
                </span>
                <span class="font-mono">{pct(r.breakdown.scam_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">{gettext("Acceso")}</span>
                <span class="font-mono">{pct(r.breakdown.access_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">
                  {gettext("Ruta (amenazas y riesgo base)")}
                  <span :if={@radar_degraded} class="text-warning">
                    · {gettext("radar degradado: solo línea base")}
                  </span>
                </span>
                <span class="font-mono">{pct(r.breakdown.route_certainty)}</span>
              </li>
              <li class="flex justify-between gap-3">
                <span class="eth-muted">
                  <%= if r.history.destination do %>
                    {gettext("Liquidez")}
                  <% else %>
                    {gettext("Liquidez (neutra hasta tener historial)")}
                  <% end %>
                </span>
                <span class="font-mono">{pct(r.breakdown.liquidity)}</span>
              </li>
            </ul>

            <div class="mt-5 flex flex-col gap-2">
              <span title={start_run_blocked(@pilot, r)}>
                <button
                  id="start-run"
                  type="button"
                  phx-click="start_run"
                  disabled={start_run_blocked(@pilot, r) != nil}
                  class="eth-chamfer-sm btn btn-accent w-full font-display tracking-wide"
                >
                  <.icon name="hero-rocket-launch" class="size-4" /> {gettext("Iniciar viaje")}
                </button>
              </span>
              <div class="grid grid-cols-3 gap-2">
                <%= if scam?(r) do %>
                  <button id="copy-detail" type="button" disabled class="btn btn-sm">
                    <.icon name="hero-no-symbol" class="size-4" /> {gettext("Multibuy bloqueado")}
                  </button>
                <% else %>
                  <button
                    id="copy-detail"
                    type="button"
                    phx-hook=".Clipboard"
                    data-text={multibuy(r)}
                    class="btn btn-sm btn-primary btn-outline"
                  >
                    <.icon name="hero-clipboard-document" class="size-4" /> {gettext("Multibuy")}
                  </button>
                <% end %>
                <span title={
                  if scam?(r),
                    do: gettext("Bloqueada: SCAM"),
                    else: action_blocked(@pilot, :waypoint)
                }>
                  <button
                    id="set-route"
                    type="button"
                    phx-click="set_route"
                    disabled={scam?(r) or action_blocked(@pilot, :waypoint) != nil}
                    class="btn btn-sm w-full phx-click-loading:opacity-70"
                  >
                    <.icon name="hero-map" class="size-4 phx-click-loading:hidden" />
                    <span class="hidden phx-click-loading:inline"><.spinner
                      size={14}
                      class="text-current"
                    /></span>
                    {gettext("Fijar ruta")}
                  </button>
                </span>
                <span title={action_blocked(@pilot, :market)}>
                  <button
                    id="open-market"
                    type="button"
                    phx-click="open_market"
                    disabled={action_blocked(@pilot, :market) != nil}
                    class="btn btn-sm w-full"
                  >
                    <.icon name="hero-building-storefront" class="size-4" /> {gettext("Mercado")}
                  </button>
                </span>
              </div>
            </div>
            <p :if={@pilot} class="mt-2 text-xs eth-faint">
              {gettext(
                "El autopiloto usa su propia preferencia de ruta (ESI no permite leerla ni cambiarla)."
              )}
            </p>
          </div>
        <% true -> %>
          <h2 id="detail-title" class="eth-kicker">{gettext("Ficha del contrato")}</h2>
          <p class="mt-2 text-sm eth-muted">
            {gettext(
              "Elegí una oportunidad para ver el cálculo, el libro consumido y el porqué de su TVS."
            )}
          </p>
          <p class="mt-3 text-xs eth-faint">
            <.link href={EthWeb.Docs.href(:board)} class="link link-primary">
              {gettext("Cómo leer el tablón")}
            </.link>
          </p>
      <% end %>
    </aside>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".Clipboard">
    export default {
      mounted() {
        this.el.addEventListener("click", (event) => {
          event.stopPropagation()
          navigator.clipboard.writeText(this.el.dataset.text).then(() => this.pushEvent("copied", {}))
        })
      }
    }
  </script>
</Layouts.app>
